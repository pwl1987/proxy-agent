[Unit]
Description=proxy-agent user health check for profile %i
Requires=proxy-agent@%i.service
After=proxy-agent@%i.service

[Service]
Type=oneshot
Environment=PA_STATE_DIR=%t/proxy-agent/run/%i
Environment=PA_LOG_DIR=%t/proxy-agent/log/%i
ExecStart=@BIN@/proxy-agent-health --profile %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
