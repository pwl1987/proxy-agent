{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pwl1987/proxy-agent/schema/proxy-agent-backends.json",
  "title": "proxy-agent backend capability contract",
  "description": "Machine-readable backend capability and option metadata consumed by the future control-plane UI and API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backends"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "backends": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/backend"}
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["string", "integer", "boolean", "secret_ref"]},
        "required": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed", "capabilities", "options"],
      "properties": {
        "managed": {"type": "boolean"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "enum": ["socks5", "http_native", "dynamic_dns", "stream_proxy"]},
          "uniqueItems": true
        },
        "derived_capabilities": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        }
      }
    }
  },
  "examples": [
    {
      "ssh-socks": {
        "managed": true,
        "capabilities": ["socks5", "dynamic_dns", "stream_proxy"],
        "options": []
      }
    }
  ],
  "backends": {
    "ssh-socks": {
      "managed": true,
      "capabilities": ["socks5", "dynamic_dns", "stream_proxy"],
      "options": [
        {"name": "remote_host", "type": "string", "required": true},
        {"name": "remote_user", "type": "string", "required": true},
        {"name": "remote_port", "type": "integer", "required": false},
        {"name": "remote_ssh_key_ref", "type": "secret_ref", "required": true},
        {"name": "autossh_monitor_port", "type": "integer", "required": false},
        {"name": "ssh_server_alive_interval", "type": "integer", "required": false},
        {"name": "ssh_server_alive_count_max", "type": "integer", "required": false},
        {"name": "ssh_strict_host_key_checking", "type": "string", "required": true},
        {"name": "ssh_known_hosts_ref", "type": "string", "required": false}
      ]
    },
    "local-endpoint": {
      "managed": false,
      "capabilities": ["stream_proxy"],
      "derived_capabilities": {
        "socks5": "LOCAL_PROXY_URL uses socks5:// or socks5h://",
        "http_native": "LOCAL_PROXY_URL uses http:// or https://"
      },
      "options": [
        {"name": "proxy_url", "type": "string", "required": true},
        {"name": "status_target", "type": "string", "required": false}
      ]
    },
    "sing-box": {
      "managed": true,
      "capabilities": ["socks5", "stream_proxy"],
      "options": [
        {"name": "config_path", "type": "string", "required": true},
        {"name": "binary", "type": "string", "required": false}
      ]
    },
    "mihomo": {
      "managed": true,
      "capabilities": ["socks5", "stream_proxy"],
      "options": [
        {"name": "config_path", "type": "string", "required": true},
        {"name": "binary", "type": "string", "required": false}
      ]
    },
    "http-connect": {
      "managed": false,
      "capabilities": ["http_native", "stream_proxy"],
      "options": [
        {"name": "proxy_url", "type": "string", "required": true}
      ]
    }
  }
}
