# Optional proxy-agent Web management listener overrides.
# Default remains loopback-only HTTP on 127.0.0.1:8443.
PA_WEB_LISTEN=127.0.0.1
PA_WEB_PORT=8443
PA_CONTROL_SOCKET=/run/proxy-agent/control.sock

# To expose the Web management plane beyond loopback, both TLS values are required.
# The service will refuse a non-loopback listener without them.
# PA_WEB_TLS_CERT=/etc/proxy-agent/tls/server.crt
# PA_WEB_TLS_KEY=/etc/proxy-agent/tls/server.key
