[Unit]
Description=proxy-agent health check and recovery
After=proxy-agent.service
Requires=proxy-agent.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
ExecStart=/bin/bash @PREFIX@/bin/proxy-agent-health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
