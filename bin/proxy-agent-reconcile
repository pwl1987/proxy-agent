#!/usr/bin/env python3
"""Reconcile canonical desired state into a safe legacy runtime projection."""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REVISION_STORE = ROOT / "lib" / "revision-store.sh"
EXPORTER = ROOT / "lib" / "typed-legacy-export.py"


def call_store(function: str, *args: str) -> str:
    cmd = ["bash", "-c", 'source "$1"; shift; "$FUNC" "$@"', "_", str(REVISION_STORE), *args]
    env = os.environ.copy()
    env["FUNC"] = function
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if p.returncode:
        raise RuntimeError(p.stderr.decode("utf-8", errors="replace").strip() or f"revision operation failed: {function}")
    return p.stdout.decode("utf-8")


def atomic_write(path: Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def main() -> int:
    state_dir = Path(os.environ.get("PA_STATE_DIR", "/run/proxy-agent"))
    profile = os.environ.get("PA_PROFILE", "")
    if profile and os.environ.get("PA_STATE_DIR_EXPLICIT", "false") != "true":
        state_dir = state_dir / profile

    desired_revision = int(call_store("revision_desired_revision"))
    if desired_revision == 0:
        print(json.dumps({"schema_version": 1, "status": "idle", "desired_revision": 0, "observed_revision": 0}, separators=(",", ":")))
        return 0

    desired = json.loads(call_store("revision_desired"))
    revision = json.loads(call_store("revision_get", str(desired_revision)))
    if desired != revision["config"]:
        raise RuntimeError(f"desired state mismatch for revision {desired_revision}")

    exporter = subprocess.run(
        [sys.executable, str(EXPORTER)],
        input=json.dumps(desired, ensure_ascii=False, separators=(",", ":")),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=ROOT,
        check=False,
    )
    if exporter.returncode:
        raise RuntimeError(exporter.stderr.strip() or "typed-to-runtime projection failed")

    runtime_dir = state_dir / "runtime"
    runtime_config = runtime_dir / "proxy-agent.conf"
    observed_state = runtime_dir / "reconcile-state.json"
    atomic_write(runtime_config, exporter.stdout)
    atomic_write(
        observed_state,
        json.dumps(
            {
                "schema_version": 1,
                "status": "projected",
                "desired_revision": desired_revision,
                "observed_revision": desired_revision,
                "runtime_config": str(runtime_config),
            },
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ) + "\n",
    )
    print(json.dumps({"schema_version": 1, "status": "projected", "desired_revision": desired_revision, "observed_revision": desired_revision, "runtime_config": str(runtime_config)}, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"proxy-agent-reconcile: ERROR: {exc}", file=sys.stderr)
        raise SystemExit(2)
