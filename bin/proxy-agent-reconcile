#!/usr/bin/env python3
"""Reconcile canonical desired state into the runtime and optionally activate it."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path
from typing import Optional

try:
    import fcntl
except ImportError:  # pragma: no cover - Linux reference runtime provides fcntl.
    fcntl = None

ROOT = Path(__file__).resolve().parent.parent
REVISION_STORE = ROOT / "lib" / "revision-store.sh"
EXPORTER = ROOT / "lib" / "typed-legacy-export.py"
PROXY_CTL = ROOT / "bin" / "proxy-ctl"


def call_store(function: str, *args: str) -> str:
    cmd = ["bash", "-c", 'source "$1"; shift; "$FUNC" "$@"', "_", str(REVISION_STORE), *args]
    env = os.environ.copy()
    env["FUNC"] = function
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if p.returncode:
        raise RuntimeError(p.stderr.decode("utf-8", errors="replace").strip() or f"revision operation failed: {function}")
    return p.stdout.decode("utf-8")


def run_proxy_ctl(config: Path, command: str) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["PA_CONFIG"] = str(config)
    return subprocess.run(
        [str(PROXY_CTL), command],
        cwd=ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def atomic_write(path: Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


@contextmanager
def reconcile_lock(state_dir: Path):
    state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = state_dir / ".reconcile.lock"
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        os.chmod(lock_path, 0o600)
        if fcntl is not None:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            if fcntl is not None:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def bootstrap_desired() -> int:
    current = int(call_store("revision_current"))
    if current != 0:
        return current
    source_config = Path(os.environ.get("PA_BOOTSTRAP_CONFIG", os.environ.get("PA_CONFIG", "/etc/proxy-agent/proxy-agent.conf")))
    exported = subprocess.run(
        [str(PROXY_CTL), "config", "export-typed"],
        cwd=ROOT,
        env={**os.environ, "PA_CONFIG": str(source_config)},
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if exported.returncode:
        raise RuntimeError(exported.stderr.strip() or "bootstrap typed export failed")
    config = json.loads(exported.stdout)
    payload = json.dumps(config, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
    revision = int(call_store("revision_record", payload, "bootstrap", "bootstrap legacy configuration", "passed", "pending"))
    call_store("revision_set_desired", str(revision), payload)
    return revision


def runtime_requires_stop(config: Path) -> bool:
    """Return true only when the previous runtime owns a stoppable process/adapter."""
    backend = ""
    http_enabled = "false"
    try:
        for raw_line in config.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if line.startswith("BACKEND="):
                backend = line.split("=", 1)[1].strip().strip("\"'")
            elif line.startswith("HTTP_ENABLED="):
                http_enabled = line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        return True
    if http_enabled == "true":
        return True
    return backend in {"ssh-socks", "sing-box", "mihomo"}


def activate(candidate_config: Path, runtime_config: Path, desired_revision: int, state_path: Path) -> dict[str, object]:
    backup = runtime_config.with_name(f".{runtime_config.name}.previous")
    had_previous = runtime_config.exists()
    previous_active = os.environ.get("PA_RUNTIME_ACTIVE_CONFIG", "")
    previous_source: Optional[Path] = Path(previous_active) if previous_active else None

    if had_previous:
        shutil.copy2(runtime_config, backup)
        previous_source = backup

    if previous_source is not None and runtime_requires_stop(previous_source):
        old_stop = run_proxy_ctl(previous_source, "stop")
        if old_stop.returncode:
            if backup.exists():
                backup.unlink()
            raise RuntimeError(old_stop.stderr.strip() or "failed to stop previous runtime")

    try:
        os.replace(candidate_config, runtime_config)
        candidate_config = runtime_config
        candidate_start = run_proxy_ctl(runtime_config, "start")
        if candidate_start.returncode:
            raise RuntimeError(candidate_start.stderr.strip() or "candidate runtime activation failed")
    except Exception as exc:
        if had_previous and backup.exists():
            os.replace(backup, runtime_config)
            if runtime_requires_stop(runtime_config):
                restored = run_proxy_ctl(runtime_config, "start")
                if restored.returncode:
                    raise RuntimeError(f"{exc}; rollback runtime start also failed") from exc
        elif runtime_config.exists():
            runtime_config.unlink()
        raise

    if backup.exists():
        backup.unlink()
    result = {
        "schema_version": 1,
        "status": "activated",
        "desired_revision": desired_revision,
        "observed_revision": desired_revision,
        "runtime_config": str(runtime_config),
    }
    atomic_write(state_path, json.dumps(result, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n")
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="proxy-agent desired-state reconciler")
    parser.add_argument("--bootstrap", action="store_true", help="seed desired state from the legacy config when no revision exists")
    parser.add_argument("--activate", action="store_true", help="activate the projected runtime configuration")
    args = parser.parse_args()

    # Profile context is resolved by the caller (for example Control API or
    # proxy-ctl). The reconciler consumes PA_STATE_DIR as-is and does not
    # derive a second profile suffix. This keeps revision/runtime state in
    # exactly one directory for named profiles.
    state_dir = Path(os.environ.get("PA_STATE_DIR", "/run/proxy-agent"))

    with reconcile_lock(state_dir):
        if args.bootstrap:
            bootstrap_desired()

        desired_revision = int(call_store("revision_desired_revision"))
        if desired_revision == 0:
            print(json.dumps({"schema_version": 1, "status": "idle", "desired_revision": 0, "observed_revision": 0}, separators=(",", ":")))
            return 0

        desired = json.loads(call_store("revision_desired"))
        revision = json.loads(call_store("revision_get", str(desired_revision)))
        if desired != revision["config"]:
            raise RuntimeError(f"desired state mismatch for revision {desired_revision}")

        exporter = subprocess.run(
            [sys.executable, str(EXPORTER)],
            input=json.dumps(desired, ensure_ascii=False, separators=(",", ":")),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=ROOT,
            check=False,
        )
        if exporter.returncode:
            raise RuntimeError(exporter.stderr.strip() or "typed-to-runtime projection failed")

        runtime_dir = state_dir / "runtime"
        runtime_config = runtime_dir / "proxy-agent.conf"
        observed_state = runtime_dir / "reconcile-state.json"
        if args.activate:
            candidate_config = runtime_dir / f".proxy-agent.conf.candidate.{os.getpid()}"
            atomic_write(candidate_config, exporter.stdout)
            try:
                result = activate(candidate_config, runtime_config, desired_revision, observed_state)
            finally:
                if candidate_config.exists():
                    candidate_config.unlink()
        else:
            atomic_write(runtime_config, exporter.stdout)
            result = {
                "schema_version": 1,
                "status": "projected",
                "desired_revision": desired_revision,
                "observed_revision": desired_revision,
                "runtime_config": str(runtime_config),
            }
            atomic_write(observed_state, json.dumps(result, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n")

        print(json.dumps(result, separators=(",", ":"), sort_keys=True))
        return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"proxy-agent-reconcile: ERROR: {exc}", file=sys.stderr)
        raise SystemExit(2)
