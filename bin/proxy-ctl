#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/profile.sh"
source "$ROOT/lib/backend-capabilities.sh"
source "$ROOT/lib/backend.sh"
source "$ROOT/lib/route.sh"
source "$ROOT/adapters/privoxy.sh"

PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || die 'usage: proxy-ctl --profile <name> <command> [args]'
  PROFILE_NAME="$2"
  shift 2
fi

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME"
  PA_STATE_DIR="${PA_STATE_DIR:-/run/proxy-agent}/${PROFILE_NAME}"
else
  load_config
fi

if [[ -n "$PROFILE_NAME" ]]; then
  : "${BACKEND:=ssh-socks}"
  : "${SOCKS_BIND:=127.0.0.1}"
  : "${SOCKS_PORT:=1080}"
  : "${HTTP_ENABLED:=false}"
  : "${HTTP_BIND:=127.0.0.1}"
  : "${HTTP_PORT:=8118}"
  : "${HEALTH_TIMEOUT:=10}"
fi

backend_load

adapter_start() {
  [[ "${HTTP_ENABLED:-false}" == "true" ]] || return 0
  backend_require_capability socks5
  adapter_privoxy_start
}
adapter_stop() { [[ "${HTTP_ENABLED:-false}" == "true" ]] && adapter_privoxy_stop; }
cmd_start() {
  backend_start
  if ! adapter_start; then backend_stop; die 'proxy adapter failed to start'; fi
  log "started profile=${PROFILE_NAME:-default} backend=$BACKEND endpoint=$(backend_endpoint) http=${HTTP_ENABLED:-false} foreground=${PA_FOREGROUND:-false}"
}
cmd_stop() { adapter_stop; backend_stop; log 'stopped'; }
cmd_restart() { cmd_stop; sleep 1; cmd_start; }
json_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}
cmd_status() {
  if [[ "${1:-}" == '--json' ]]; then
    local backend_state='stopped' adapter_state='disabled' endpoint
    backend_status >/dev/null 2>&1 && backend_state='listening'
    if [[ "${HTTP_ENABLED:-false}" == 'true' ]]; then
      adapter_privoxy_status >/dev/null 2>&1 && adapter_state='listening' || adapter_state='stopped'
    fi
    endpoint="$(backend_endpoint 2>/dev/null || printf '')"
    printf '{"schema_version":1,"profile":%s,"backend":%s,"backend_status":%s,"endpoint":%s,"http_enabled":%s,"http_status":%s}\n' \
      "$(json_quote "${PROFILE_NAME:-default}")" "$(json_quote "$BACKEND")" "$(json_quote "$backend_state")" \
      "$(json_quote "$endpoint")" "${HTTP_ENABLED:-false}" "$(json_quote "$adapter_state")"
    return 0
  fi
  printf 'proxy-agent\n  profile: %s\n  backend: %s\n' "${PROFILE_NAME:-default}" "$BACKEND"
  if backend_status 2>/dev/null; then echo '  backend: listening'; else echo '  backend: not listening'; fi
  printf '  endpoint: %s\n' "$(backend_endpoint 2>/dev/null || printf 'unavailable')"
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    if adapter_privoxy_status 2>/dev/null; then echo '  HTTP:     listening'; else echo '  HTTP:     not listening'; fi
  else
    echo '  HTTP:     disabled'
  fi
  printf '  remote: %s@%s:%s\n' "${REMOTE_USER:-}" "${REMOTE_HOST:-}" "${REMOTE_PORT:-22}"
}
curl_via_endpoint() {
  local url="$1" endpoint
  endpoint="$(backend_endpoint)"
  curl -fsS --connect-timeout "$HEALTH_TIMEOUT" --max-time "$((HEALTH_TIMEOUT + 5))" --proxy "$endpoint" "$url" >/dev/null
}
curl_via_http() {
  local url="$1"
  curl -fsS --connect-timeout "$HEALTH_TIMEOUT" --max-time "$((HEALTH_TIMEOUT + 5))" --proxy "http://${HTTP_BIND}:${HTTP_PORT}" "$url" >/dev/null
}
cmd_test() {
  require_cmd curl
  echo '== proxy-agent connectivity test =='
  local failed=0 target
  IFS=',' read -r -a targets <<< "${HEALTH_TARGETS:-}"
  for target in "${targets[@]}"; do
    [[ -n "$target" ]] || continue
    if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
      if curl_via_http "$target"; then printf 'PASS  HTTP     %s\n' "$target"; else printf 'FAIL  HTTP     %s\n' "$target"; failed=1; fi
    else
      if curl_via_endpoint "$target"; then printf 'PASS  BACKEND  %s\n' "$target"; else printf 'FAIL  BACKEND  %s\n' "$target"; failed=1; fi
    fi
  done
  return "$failed"
}
cmd_diagnose() {
  echo '== proxy-agent diagnosis =='
  case "$BACKEND" in
    ssh-socks)
      for c in ssh autossh curl ss; do
        command -v "$c" >/dev/null 2>&1 && printf 'OK    %s\n' "$c" || printf 'MISS  %s\n' "$c"
      done
      ;;
    local-endpoint)
      for c in curl; do
        command -v "$c" >/dev/null 2>&1 && printf 'OK    %s\n' "$c" || printf 'MISS  %s\n' "$c"
      done
      ;;
    *)
      command -v curl >/dev/null 2>&1 && echo 'OK    curl' || echo 'MISS  curl'
      ;;
  esac
  [[ "${HTTP_ENABLED:-false}" != "true" ]] || { command -v privoxy >/dev/null 2>&1 && echo 'OK    privoxy' || echo 'MISS  privoxy'; }
  echo "profile: ${PROFILE_NAME:-default}"
  echo "config: $PA_CONFIG"
  echo "backend: $BACKEND"
  echo "endpoint: $(backend_endpoint 2>/dev/null || printf unavailable)"
  echo "capabilities: $(backend_capabilities | tr '\n' ' ')"
  if [[ "$BACKEND" == 'ssh-socks' && -n "${REMOTE_HOST:-}" && "${REMOTE_HOST:-}" != *example.com && "${REMOTE_HOST:-}" != 'your-ssh-host' ]]; then
    getent hosts "$REMOTE_HOST" || warn "cannot resolve $REMOTE_HOST"
  fi
  backend_status >/dev/null 2>&1 || warn "backend '$BACKEND' reports stopped/unhealthy"
}
cmd_env() {
  if [[ "${1:-}" == '--off' ]]; then
    printf 'unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NO_PROXY no_proxy\n'
    return
  fi
  local no_proxy="${DIRECT_CIDRS:-}"
  [[ -z "${DIRECT_DOMAINS:-}" ]] || no_proxy="${no_proxy:+${no_proxy},}${DIRECT_DOMAINS}"
  [[ -z "${NO_PROXY_EXTRA:-}" ]] || no_proxy="${no_proxy:+${no_proxy},}${NO_PROXY_EXTRA}"
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    local http="http://${HTTP_BIND}:${HTTP_PORT}"
    printf 'export HTTP_PROXY=%q HTTPS_PROXY=%q http_proxy=%q https_proxy=%q\n' "$http" "$http" "$http" "$http"
  else
    printf 'unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy\n'
  fi
  local endpoint
  endpoint="$(backend_endpoint)"
  printf 'export ALL_PROXY=%q all_proxy=%q\n' "$endpoint" "$endpoint"
  printf 'export NO_PROXY=%q no_proxy=%q\n' "$no_proxy" "$no_proxy"
}
cmd_integration() { exec "$ROOT/bin/proxy-agent-integration" "${1:-}"; }
cmd_tui() { exec "$ROOT/bin/proxy-agent-tui"; }
cmd_profiles() { exec "$ROOT/bin/proxy-agent-profile" "${1:-list}" "${2:-}"; }
cmd_capabilities() { backend_capabilities; }
cmd_doctor() {
  local rc=0
  [[ "${SOCKS_BIND:-127.0.0.1}" != '0.0.0.0' ]] || { warn 'SOCKS is exposed on all interfaces'; rc=1; }
  if [[ "${BACKEND:-}" == ssh-socks ]]; then
    [[ "${SSH_STRICT_HOST_KEY_CHECKING:-yes}" == 'yes' ]] || { warn 'SSH host-key verification is disabled'; rc=1; }
    [[ -n "${REMOTE_HOST:-}" ]] || { warn 'REMOTE_HOST is empty'; rc=1; }
    [[ "${REMOTE_HOST:-}" != 'proxy.example.com' && "${REMOTE_HOST:-}" != 'your-ssh-host' ]] || { warn 'REMOTE_HOST still uses the example placeholder'; rc=1; }
  fi
  [[ "${SOCKS_PORT:-1080}" =~ ^[0-9]+$ && "${SOCKS_PORT:-1080}" -ge 1 && "${SOCKS_PORT:-1080}" -le 65535 ]] || { warn 'invalid SOCKS_PORT'; rc=1; }
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    [[ "$HTTP_PORT" =~ ^[0-9]+$ && "$HTTP_PORT" -ge 1 && "$HTTP_PORT" -le 65535 ]] || { warn 'invalid HTTP_PORT'; rc=1; }
    command -v privoxy >/dev/null 2>&1 || { warn 'HTTP_ENABLED=true but privoxy is missing'; rc=1; }
    backend_capability socks5 || { warn 'HTTP adapter requires backend capability: socks5'; rc=1; }
  fi
  return "$rc"
}
usage() {
  cat <<'EOF'
Usage: proxy-ctl [--profile NAME] <command>
  start                  start configured backend and adapters
  stop                   stop adapters and backend
  restart                restart configured stack
  status [--json]        show runtime state
  test                   test configured targets via active proxy path
  diagnose               inspect dependencies/config/runtime
  doctor                 check unsafe or inconsistent configuration
  route <host-or-ip>     explain ordered routing decision
  env [--off]            print shell commands for proxy environment
  integration <app|all>  print application integration commands
  profiles [list|show|path] [name]
  capabilities           list backend capabilities
  tui                    open interactive terminal dashboard
EOF
}
case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) shift; cmd_status "${1:-}" ;;
  test) cmd_test ;;
  diagnose) cmd_diagnose ;;
  doctor) cmd_doctor ;;
  route) shift; route_explain "${1:-}" ;;
  env) shift; cmd_env "${1:-}" ;;
  integration) shift; cmd_integration "${1:-}" ;;
  profiles) shift; cmd_profiles "${1:-list}" "${2:-}" ;;
  capabilities) cmd_capabilities ;;
  tui) cmd_tui ;;
  *) usage; exit 2 ;;
esac
