#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH")"
fi
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/profile.sh"
source "$ROOT/lib/backend-capabilities.sh"
source "$ROOT/lib/backend.sh"
source "$ROOT/lib/route.sh"
source "$ROOT/lib/config.sh"
source "$ROOT/adapters/privoxy.sh"
source "$ROOT/lib/state.sh"

PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || die '用法：proxy-ctl --profile <名称> <命令> [参数]'
  PROFILE_NAME="$2"
  shift 2
fi

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME"
  if [[ "${PA_STATE_DIR_EXPLICIT:-false}" != true ]]; then
    PA_STATE_DIR="${PA_STATE_DIR}/${PROFILE_NAME}"
  fi
  if [[ "${PA_LOG_DIR_EXPLICIT:-false}" != true ]]; then
    PA_LOG_DIR="${PA_LOG_DIR}/${PROFILE_NAME}"
  fi
  apply_config_defaults
else
  load_config
fi

backend_load

adapter_start() {
  [[ "${HTTP_ENABLED:-false}" == "true" ]] || return 0
  backend_require_capability socks5
  adapter_privoxy_start
}
adapter_stop() { [[ "${HTTP_ENABLED:-false}" == "true" ]] && adapter_privoxy_stop; }
cmd_validate() { config_validate; }
cmd_start() {
  config_validate
  backend_start
  if ! adapter_start; then backend_stop; die 'HTTP 代理适配器启动失败'; fi
  state_mark_started
  state_sync
  log "started profile=${PROFILE_NAME:-default} backend=$BACKEND endpoint=$(backend_endpoint) http=${HTTP_ENABLED:-false}"
}
cmd_stop() {
  adapter_stop
  backend_stop
  state_mark_stopped
  state_sync
  log 'stopped'
}
cmd_run() {
  config_validate
  cmd_start
  local pid
  trap 'cmd_stop >/dev/null 2>&1 || true' TERM INT EXIT
  if backend_managed >/dev/null 2>&1 && pid="$(backend_pid 2>/dev/null || true)" && [[ "$pid" =~ ^[0-9]+$ ]]; then
    if wait "$pid"; then
      return 0
    fi
    warn "托管后端进程 $pid 异常退出"
    return 1
  fi
  while :; do
    sleep 3600 &
    wait "$!" || true
  done
}
cmd_restart() { cmd_stop; sleep 1; cmd_start; }
json_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}
cmd_status() {
  if [[ "${1:-}" == '--json=v2' ]]; then
    state_sync
    cat "$(state_file)"
    return 0
  fi
  if [[ "${1:-}" == '--json' ]]; then
    local backend_state='stopped' adapter_state='disabled' endpoint
    backend_status >/dev/null 2>&1 && backend_state='listening'
    if [[ "${HTTP_ENABLED:-false}" == 'true' ]]; then
      adapter_privoxy_status >/dev/null 2>&1 && adapter_state='listening' || adapter_state='stopped'
    fi
    endpoint="$(backend_endpoint 2>/dev/null || printf '')"
    printf '{"schema_version":1,"profile":%s,"backend":%s,"backend_status":%s,"endpoint":%s,"http_enabled":%s,"http_status":%s}\n' \
      "$(json_quote "${PROFILE_NAME:-default}")" "$(json_quote "$BACKEND")" "$(json_quote "$backend_state")" \
      "$(json_quote "$endpoint")" "${HTTP_ENABLED:-false}" "$(json_quote "$adapter_state")"
    return 0
  fi
  printf 'proxy-agent 代理控制平面\n  配置档案: %s\n  后端: %s\n' "${PROFILE_NAME:-default}" "$BACKEND"
  if backend_status 2>/dev/null; then echo '  后端状态: 正常监听'; else echo '  后端状态: 未监听'; fi
  printf '  endpoint: %s\n' "$(backend_endpoint 2>/dev/null || printf '不可用')"
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    if adapter_privoxy_status 2>/dev/null; then echo '  HTTP状态: 正常监听'; else echo '  HTTP状态: 未监听'; fi
  else
    echo '  HTTP状态: 已禁用'
  fi
  printf '  远端: %s@%s:%s\n' "${REMOTE_USER:-}" "${REMOTE_HOST:-}" "${REMOTE_PORT:-22}"
}
curl_via_endpoint() {
  local url="$1" endpoint
  endpoint="$(backend_endpoint)"
  curl -fsS --connect-timeout "$HEALTH_TIMEOUT" --max-time "$((HEALTH_TIMEOUT + 5))" --proxy "$endpoint" "$url" >/dev/null
}
curl_via_http() {
  local url="$1"
  curl -fsS --connect-timeout "$HEALTH_TIMEOUT" --max-time "$((HEALTH_TIMEOUT + 5))" --proxy "http://${HTTP_BIND}:${HTTP_PORT}" "$url" >/dev/null
}
cmd_test() {
  require_cmd curl
  echo '== proxy-agent 连通性测试 =='
  local failed=0 target
  IFS=',' read -r -a targets <<< "${HEALTH_TARGETS:-}"
  for target in "${targets[@]}"; do
    [[ -n "$target" ]] || continue
    if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
      if curl_via_http "$target"; then printf '通过  HTTP     %s\n' "$target"; else printf '失败  HTTP     %s\n' "$target"; failed=1; fi
    else
      if curl_via_endpoint "$target"; then printf '通过  SOCKS    %s\n' "$target"; else printf '失败  SOCKS    %s\n' "$target"; failed=1; fi
    fi
  done
  return "$failed"
}
cmd_diagnose() {
  echo '== proxy-agent 运行诊断 =='
  case "$BACKEND" in
    ssh-socks)
      for c in ssh autossh curl ss; do
        command -v "$c" >/dev/null 2>&1 && printf '正常  %s\n' "$c" || printf '缺少  %s\n' "$c"
      done
      ;;
    local-endpoint|http-connect)
      command -v curl >/dev/null 2>&1 && echo '正常  curl' || echo '缺少  curl'
      ;;
    mihomo)
      command -v "${MIHOMO_BIN:-mihomo}" >/dev/null 2>&1 && echo "正常  ${MIHOMO_BIN:-mihomo}" || echo "缺少  ${MIHOMO_BIN:-mihomo}"
      command -v curl >/dev/null 2>&1 && echo '正常  curl' || echo '缺少  curl'
      ;;
    sing-box)
      command -v "${SING_BOX_BIN:-sing-box}" >/dev/null 2>&1 && echo "正常  ${SING_BOX_BIN:-sing-box}" || echo "缺少  ${SING_BOX_BIN:-sing-box}"
      command -v curl >/dev/null 2>&1 && echo '正常  curl' || echo '缺少  curl'
      ;;
    *)
      command -v curl >/dev/null 2>&1 && echo '正常  curl' || echo '缺少  curl'
      ;;
  esac
  [[ "${HTTP_ENABLED:-false}" != "true" ]] || { command -v privoxy >/dev/null 2>&1 && echo '正常  privoxy' || echo '缺少  privoxy'; }
  echo "配置档案: ${PROFILE_NAME:-default}"
  echo "配置文件: $PA_CONFIG"
  echo "后端: $BACKEND"
  echo "endpoint: $(backend_endpoint 2>/dev/null || printf 不可用)"
  echo "能力: $(backend_capabilities | tr '\n' ' ')"
  if [[ "$BACKEND" == 'ssh-socks' && -n "${REMOTE_HOST:-}" && "${REMOTE_HOST:-}" != *example.com && "${REMOTE_HOST:-}" != 'your-ssh-host' ]]; then
    getent hosts "$REMOTE_HOST" || warn "无法解析远端主机 $REMOTE_HOST"
  fi
  backend_status >/dev/null 2>&1 || warn "后端 '$BACKEND' 当前未运行或不健康"
}
cmd_env() {
  if [[ "${1:-}" == '--off' ]]; then
    printf 'unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NO_PROXY no_proxy\n'
    return
  fi
  local no_proxy="${DIRECT_CIDRS:-}"
  [[ -z "${DIRECT_DOMAINS:-}" ]] || no_proxy="${no_proxy:+${no_proxy},}${DIRECT_DOMAINS}"
  [[ -z "${NO_PROXY_EXTRA:-}" ]] || no_proxy="${no_proxy:+${no_proxy},}${NO_PROXY_EXTRA}"
  local endpoint
  endpoint="$(backend_endpoint)"
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    local http="http://${HTTP_BIND}:${HTTP_PORT}"
    printf 'export HTTP_PROXY=%q HTTPS_PROXY=%q http_proxy=%q https_proxy=%q\n' "$http" "$http" "$http" "$http"
  elif backend_capability http_native >/dev/null 2>&1; then
    printf 'export HTTP_PROXY=%q HTTPS_PROXY=%q http_proxy=%q https_proxy=%q\n' "$endpoint" "$endpoint" "$endpoint" "$endpoint"
  else
    printf 'unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy\n'
  fi
  if backend_capability socks5 >/dev/null 2>&1; then
    printf 'export ALL_PROXY=%q all_proxy=%q\n' "$endpoint" "$endpoint"
  else
    printf 'unset ALL_PROXY all_proxy\n'
  fi
  printf 'export NO_PROXY=%q no_proxy=%q\n' "$no_proxy" "$no_proxy"
}
cmd_integration() { exec "$ROOT/bin/proxy-agent-integration" "${1:-}"; }
cmd_tui() { exec "$ROOT/bin/proxy-agent-tui"; }
cmd_profiles() { exec "$ROOT/bin/proxy-agent-profile" "${1:-list}" "${2:-}"; }
cmd_capabilities() { backend_capabilities; }
cmd_history() { exec "$ROOT/bin/proxy-agent-health-history" "${@}"; }
cmd_config() {
  case "${1:-}" in
    export-typed)
      config_validate >/dev/null || return 1
      require_cmd python3
      exec env \
        BACKEND="$BACKEND" \
        PA_ACTIVE_PROFILE="${PROFILE_NAME:-default}" \
        REMOTE_HOST="${REMOTE_HOST:-}" REMOTE_USER="${REMOTE_USER:-}" REMOTE_PORT="${REMOTE_PORT:-22}" REMOTE_SSH_KEY="${REMOTE_SSH_KEY:-}" \
        AUTOSSH_MONITOR_PORT="${AUTOSSH_MONITOR_PORT:-0}" SSH_SERVER_ALIVE_INTERVAL="${SSH_SERVER_ALIVE_INTERVAL:-30}" SSH_SERVER_ALIVE_COUNT_MAX="${SSH_SERVER_ALIVE_COUNT_MAX:-3}" \
        SSH_STRICT_HOST_KEY_CHECKING="${SSH_STRICT_HOST_KEY_CHECKING:-yes}" SSH_KNOWN_HOSTS="${SSH_KNOWN_HOSTS:-~/.ssh/known_hosts}" \
        LOCAL_PROXY_URL="${LOCAL_PROXY_URL:-}" LOCAL_PROXY_STATUS_TARGET="${LOCAL_PROXY_STATUS_TARGET:-}" \
        SING_BOX_CONFIG="${SING_BOX_CONFIG:-}" SING_BOX_BIN="${SING_BOX_BIN:-sing-box}" \
        MIHOMO_CONFIG="${MIHOMO_CONFIG:-}" MIHOMO_BIN="${MIHOMO_BIN:-mihomo}" \
        HTTP_CONNECT_PROXY_URL="${HTTP_CONNECT_PROXY_URL:-}" \
        SOCKS_BIND="$SOCKS_BIND" SOCKS_PORT="$SOCKS_PORT" HTTP_ENABLED="$HTTP_ENABLED" HTTP_BIND="$HTTP_BIND" HTTP_PORT="$HTTP_PORT" \
        DIRECT_CIDRS="${DIRECT_CIDRS:-}" DIRECT_DOMAINS="${DIRECT_DOMAINS:-}" NO_PROXY_EXTRA="${NO_PROXY_EXTRA:-}" ROUTE_RULES="${ROUTE_RULES:-}" \
        HEALTH_TARGETS="${HEALTH_TARGETS:-}" HEALTH_NETWORK_REQUIRED="${HEALTH_NETWORK_REQUIRED:-false}" HEALTH_TIMEOUT="$HEALTH_TIMEOUT" HEALTH_RETRIES="$HEALTH_RETRIES" \
        HEALTH_BACKOFF="$HEALTH_BACKOFF" HEALTH_AUTO_RECOVER="$HEALTH_AUTO_RECOVER" \
        INTEGRATE_GIT="$INTEGRATE_GIT" INTEGRATE_DOCKER="$INTEGRATE_DOCKER" INTEGRATE_PIP="$INTEGRATE_PIP" INTEGRATE_NPM="$INTEGRATE_NPM" \
        python3 "$ROOT/lib/legacy-typed-export.py"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}
cmd_doctor() {
  local rc=0
  [[ "${SOCKS_BIND:-127.0.0.1}" != '0.0.0.0' ]] || { warn 'SOCKS 暴露在所有网络接口'; rc=1; }
  if [[ "${BACKEND:-}" == ssh-socks ]]; then
    [[ "${SSH_STRICT_HOST_KEY_CHECKING:-yes}" == 'yes' ]] || { warn 'SSH host key 校验已关闭'; rc=1; }
    [[ -n "${REMOTE_HOST:-}" ]] || { warn 'REMOTE_HOST 为空'; rc=1; }
    [[ "${REMOTE_HOST:-}" != 'proxy.example.com' && "${REMOTE_HOST:-}" != 'your-ssh-host' ]] || { warn 'REMOTE_HOST 仍使用示例占位地址'; rc=1; }
  fi
  [[ "${SOCKS_PORT:-1080}" =~ ^[0-9]+$ && "${SOCKS_PORT:-1080}" -ge 1 && "${SOCKS_PORT:-1080}" -le 65535 ]] || { warn 'SOCKS_PORT 无效'; rc=1; }
  if [[ "${HTTP_ENABLED:-false}" == "true" ]]; then
    [[ "$HTTP_PORT" =~ ^[0-9]+$ && "$HTTP_PORT" -ge 1 && "$HTTP_PORT" -le 65535 ]] || { warn 'HTTP_PORT 无效'; rc=1; }
    command -v privoxy >/dev/null 2>&1 || { warn 'HTTP_ENABLED=true，但未找到 privoxy'; rc=1; }
    backend_capability socks5 || { warn 'HTTP 适配器要求后端具备 socks5 能力'; rc=1; }
  fi
  return "$rc"
}

usage() {
  cat <<'EOF'
用法：proxy-ctl [--profile 名称] <命令>
  validate                    校验配置与 Backend 合同
  start                       启动配置的后端与适配器
  run                         启动代理栈并保持前台服务生命周期
  stop                        停止适配器与后端
  restart                     重启代理栈
  status [--json|--json=v2]  查看运行状态
  test                        测试配置的代理连通性
  diagnose                    诊断依赖、配置与运行环境
  doctor                      检查不安全或不一致的配置
  route <主机名或IPv4>        解释有序分流策略
  env [--off]                 输出 shell 代理环境变量命令
  integration <应用|all>     输出应用集成配置
  profiles [list|show|path] [名称]
                              查看配置档案
  capabilities                查看当前 Backend 能力
  config export-typed         将已验证的旧版 .conf 导出为 typed JSON
  health-history [--limit N] [--json]
                              查看健康检查历史
  tui                         打开交互式终端控制台

说明：--json 输出保持稳定的英文 schema；其他人类可读输出默认使用中文。
EOF
}
case "${1:-}" in
  validate) cmd_validate ;;
  start) cmd_start ;;
  run) cmd_run ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) shift; cmd_status "${1:-}" ;;
  test) cmd_test ;;
  diagnose) cmd_diagnose ;;
  doctor) cmd_doctor ;;
  route) shift; route_explain "${1:-}" ;;
  env) shift; cmd_env "${1:-}" ;;
  integration) shift; cmd_integration "${1:-}" ;;
  profiles) shift; cmd_profiles "${1:-list}" "${2:-}" ;;
  capabilities) cmd_capabilities ;;
  config) shift; cmd_config "${1:-}" ;;
  health-history) shift; cmd_history "${@}" ;;
  tui) cmd_tui ;;
  *) usage; exit 2 ;;
esac
