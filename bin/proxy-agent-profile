#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=../lib/profile.sh
source "$ROOT/lib/profile.sh"

usage() {
  cat <<'EOF'
Usage: proxy-agent-profile <list|show|path> [name]

Profiles live under PA_PROFILE_DIR (default: /etc/proxy-agent/profiles).
The active profile for proxy-ctl is selected with --profile NAME.
EOF
}

case "${1:-}" in
  list) profile_list ;;
  path) [[ -n "${2:-}" ]] || die 'usage: proxy-agent-profile path <name>'; profile_path "$2" ;;
  show)
    [[ -n "${2:-}" ]] || die 'usage: proxy-agent-profile show <name>'
    path="$(profile_path "$2")"
    [[ -r "$path" ]] || die "profile not found: $2"
    sed -e 's/^[[:space:]]*REMOTE_SSH_KEY=.*/REMOTE_SSH_KEY="<redacted>"/' "$path"
    ;;
  *) usage; exit 2 ;;
esac
