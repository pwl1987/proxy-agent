#!/usr/bin/env python3
"""Local Control API v1 for the proxy-agent control plane."""
from __future__ import annotations

import argparse
import json
import os
import re
import socketserver
import stat
import subprocess
import sys
import time
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler
from pathlib import Path
from urllib.parse import parse_qs, urlsplit
from typing import Any

API_VERSION = "v1"
ROOT = Path(__file__).resolve().parent.parent
PROXY_CTL = ROOT / "bin" / "proxy-ctl"
RECONCILER = Path(os.environ.get("PA_RECONCILER", ROOT / "bin" / "proxy-agent-reconcile"))
REVISION_STORE = ROOT / "lib" / "revision-store.sh"
AUDIT_STORE = ROOT / "lib" / "audit-store.sh"
COMMON = ROOT / "lib" / "common.sh"
PROFILE = ROOT / "lib" / "profile.sh"
PROFILE_CONTEXT = ROOT / "lib" / "profile-context.sh"
MAX_BODY = 1024 * 1024
PROFILE_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def json_bytes(payload: dict[str, Any]) -> bytes:
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode()


def response_envelope(kind: str, payload: Any) -> dict[str, Any]:
    return {"api_version": API_VERSION, "kind": kind, "data": payload}


def error_envelope(code: str, message: str) -> dict[str, Any]:
    return {"api_version": API_VERSION, "error": {"code": code, "message": message}}


def profile_env(profile_name: str | None) -> dict[str, str]:
    env = os.environ.copy()
    if not profile_name:
        return env
    if not PROFILE_RE.fullmatch(profile_name):
        raise ValueError("invalid profile name")
    cmd = [
        "bash", "-c",
        'source "$1"; source "$2"; source "$3"; profile_apply_context "$4"; printf "%s\\n%s\\n%s\\n%s\\n" "$PA_PROFILE" "$PA_CONFIG" "$PA_STATE_DIR" "$PA_LOG_DIR"',
        "_", str(COMMON), str(PROFILE), str(PROFILE_CONTEXT), profile_name,
    ]
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if p.returncode != 0:
        raise ValueError(p.stderr.strip() or f"profile not found: {profile_name}")
    values = p.stdout.splitlines()
    if len(values) != 4:
        raise RuntimeError("profile context returned invalid output")
    env["PA_PROFILE"] = values[0]
    env["PA_CONFIG"] = values[1]
    env["PA_STATE_DIR"] = values[2]
    env["PA_LOG_DIR"] = values[3]
    return env


def run_proxy_ctl(profile_name: str | None, *args: str, config_path: str | None = None) -> tuple[int, bytes, bytes]:
    env = profile_env(profile_name)
    command = [str(PROXY_CTL)]
    if profile_name and config_path is None:
        command += ["--profile", profile_name]
    if config_path is not None:
        env["PA_CONFIG"] = config_path
    command += list(args)
    p = subprocess.run(command, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    return p.returncode, p.stdout, p.stderr


def command_json(profile_name: str | None, *args: str, config_path: str | None = None) -> Any:
    rc, stdout, stderr = run_proxy_ctl(profile_name, *args, config_path=config_path)
    if rc != 0:
        raise RuntimeError(stderr.decode("utf-8", errors="replace").strip() or "proxy-ctl failed")
    return json.loads(stdout.decode("utf-8"))


def revision_call(profile_name: str | None, function: str, *args: str) -> bytes:
    env = profile_env(profile_name)
    cmd = ["bash", "-c", 'source "$1"; shift; "$FUNC" "$@"', "_", str(REVISION_STORE), *args]
    env["FUNC"] = function
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.decode("utf-8", errors="replace").strip() or f"revision operation failed: {function}")
    return p.stdout


def revision_call_rc(profile_name: str | None, function: str, *args: str) -> tuple[int, bytes, bytes]:
    env = profile_env(profile_name)
    cmd = ["bash", "-c", 'source "$1"; shift; "$FUNC" "$@"', "_", str(REVISION_STORE), *args]
    env["FUNC"] = function
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    return p.returncode, p.stdout, p.stderr


def audit_call(profile_name: str | None, event: dict[str, Any]) -> None:
    env = profile_env(profile_name)
    text = json.dumps(event, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
    cmd = ["bash", "-c", 'source "$1"; audit_append "$2"', "_", str(AUDIT_STORE), text]
    p = subprocess.run(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.decode("utf-8", errors="replace").strip() or "audit append failed")


def stderr_message(stderr: bytes) -> str:
    return stderr.decode("utf-8", errors="replace").strip()


def reconcile(profile_name: str | None, *args: str) -> dict[str, Any]:
    env = profile_env(profile_name)
    p = subprocess.run([str(RECONCILER), *args], cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if p.returncode != 0:
        raise RuntimeError(stderr_message(p.stderr) or "reconcile failed")
    try:
        return json.loads(p.stdout.decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"reconcile returned invalid JSON: {exc}") from exc


def observed_state(profile_name: str | None) -> dict[str, Any]:
    env = profile_env(profile_name)
    state_dir = Path(env.get("PA_STATE_DIR", "/run/proxy-agent"))
    path = state_dir / "runtime" / "reconcile-state.json"
    if not path.is_file():
        return {"status": "unknown", "desired_revision": int(revision_call(profile_name, "revision_desired_revision")), "observed_revision": 0}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"status": "unknown", "desired_revision": int(revision_call(profile_name, "revision_desired_revision")), "observed_revision": 0}


class ConflictError(Exception):
    pass


class ValidationError(Exception):
    pass


class ActivationError(Exception):
    pass


def safe_audit(profile_name: str | None, event: dict[str, Any]) -> None:
    try:
        audit_call(profile_name, event)
    except Exception as exc:
        print(f"control-api: audit append failed: {exc}", file=sys.stderr)


class ControlRequestHandler(BaseHTTPRequestHandler):
    server_version = "proxy-agent-control/1"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args: object) -> None:
        print(f"control-api: {fmt % args}", file=sys.stderr)

    def _send(self, status: HTTPStatus, payload: dict[str, Any]) -> None:
        body = json_bytes(payload)
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _read_json_body(self) -> Any:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError as exc:
            raise ValueError("invalid Content-Length") from exc
        if length < 0 or length > MAX_BODY:
            raise ValueError("request body too large")
        raw = self.rfile.read(length)
        if length and len(raw) != length:
            raise ValueError("short request body")
        return json.loads(raw.decode("utf-8")) if raw else None

    def _profile_from_path(self) -> str | None:
        values = parse_qs(urlsplit(self.path).query, keep_blank_values=True).get("profile", [])
        if not values or not values[0]:
            return None
        if not PROFILE_RE.fullmatch(values[0]):
            raise ValueError("invalid profile name")
        return values[0]

    @staticmethod
    def _profile_from_body(body: Any) -> str | None:
        if not isinstance(body, dict) or body.get("profile") in (None, ""):
            return None
        name = str(body["profile"])
        if not PROFILE_RE.fullmatch(name):
            raise ValueError("invalid profile name")
        return name

    def do_GET(self) -> None:
        try:
            profile = self._profile_from_path()
            path = urlsplit(self.path).path
            routes = {"/api/v1/status": self._status, "/api/v1/health": self._health, "/api/v1/capabilities": self._capabilities, "/api/v1/config": self._config, "/api/v1/events": self._events, "/api/v1/metrics": self._metrics, "/api/v1/revisions": self._revisions}
            handler = routes.get(path)
            if handler is not None:
                handler(profile)
                return
            if path.startswith("/api/v1/revisions/"):
                self._revision_detail(path.rsplit("/", 1)[-1], profile)
                return
            self._send(HTTPStatus.NOT_FOUND, error_envelope("not_found", "unknown endpoint"))
        except FileNotFoundError:
            self._send(HTTPStatus.NOT_FOUND, error_envelope("not_found", "revision not found"))
        except ValidationError as exc:
            self._send(HTTPStatus.UNPROCESSABLE_ENTITY, error_envelope("invalid_config", str(exc)))
        except ValueError as exc:
            self._send(HTTPStatus.BAD_REQUEST, error_envelope("invalid_request", str(exc)))
        except Exception as exc:
            self._send(HTTPStatus.INTERNAL_SERVER_ERROR, error_envelope("internal_error", str(exc)))

    def do_POST(self) -> None:
        if urlsplit(self.path).path not in {"/api/v1/validate", "/api/v1/revisions", "/api/v1/apply", "/api/v1/rollback"}:
            self._send(HTTPStatus.NOT_FOUND, error_envelope("not_found", "unknown endpoint"))
            return
        try:
            body = self._read_json_body()
            profile = self._profile_from_body(body)
            path = urlsplit(self.path).path
            if path == "/api/v1/validate":
                self._validate(body)
                self._send(HTTPStatus.OK, response_envelope("validation", {"valid": True}))
            elif path == "/api/v1/revisions":
                self._create_revision(body, profile)
            elif path == "/api/v1/apply":
                self._apply(body, profile)
            else:
                self._rollback(body, profile)
        except json.JSONDecodeError as exc:
            self._send(HTTPStatus.BAD_REQUEST, error_envelope("invalid_json", str(exc)))
        except ValidationError as exc:
            self._send(HTTPStatus.UNPROCESSABLE_ENTITY, error_envelope("invalid_config", str(exc)))
        except FileNotFoundError:
            self._send(HTTPStatus.NOT_FOUND, error_envelope("not_found", "revision not found"))
        except ConflictError as exc:
            self._send(HTTPStatus.CONFLICT, error_envelope("revision_conflict", str(exc)))
        except ActivationError as exc:
            self._send(HTTPStatus.SERVICE_UNAVAILABLE, error_envelope("activation_failed", str(exc)))
        except ValueError as exc:
            self._send(HTTPStatus.BAD_REQUEST, error_envelope("invalid_request", str(exc)))
        except Exception as exc:
            self._send(HTTPStatus.INTERNAL_SERVER_ERROR, error_envelope("internal_error", str(exc)))

    def _status(self, profile: str | None) -> None:
        observed = observed_state(profile)
        runtime_config = observed.get("runtime_config") if isinstance(observed, dict) else None
        data = command_json(profile, "status", "--json", config_path=runtime_config if runtime_config else None)
        data["control"] = observed
        data["desired_revision"] = int(revision_call(profile, "revision_desired_revision"))
        data["current_revision"] = int(revision_call(profile, "revision_current"))
        self._send(HTTPStatus.OK, response_envelope("status", data))

    def _health(self, profile: str | None) -> None:
        observed = observed_state(profile)
        runtime_config = observed.get("runtime_config") if isinstance(observed, dict) else None
        runtime = command_json(profile, "status", "--json=v2", config_path=runtime_config if runtime_config else None)
        backend = runtime.get("backend", {}) if isinstance(runtime, dict) else {}
        adapter = runtime.get("adapter", {}) if isinstance(runtime, dict) else {}
        backend_ready = backend.get("status") == "ready"
        http_enabled = adapter.get("enabled") is True
        adapter_ready = (not http_enabled) or adapter.get("status") == "ready"
        desired_revision = int(revision_call(profile, "revision_desired_revision"))
        observed_revision = int(observed.get("observed_revision", 0))
        revision_ready = desired_revision == observed_revision
        readiness = "ready" if backend_ready and adapter_ready and revision_ready else "not_ready"
        status = "ok" if readiness == "ready" else "degraded"
        self._send(HTTPStatus.OK, response_envelope("health", {"status": status, "transport": "ready", "readiness": readiness, "runtime": {"backend": backend.get("status", "unknown"), "adapter": adapter.get("status", "disabled") if http_enabled else "disabled"}, "desired_revision": desired_revision, "observed_revision": observed_revision}))

    def _capabilities(self, profile: str | None) -> None:
        status = command_json(profile, "status", "--json")
        rc, stdout, stderr = run_proxy_ctl(profile, "capabilities")
        if rc != 0:
            raise RuntimeError(stderr_message(stderr) or "capabilities failed")
        caps = [x for x in stdout.decode("utf-8", errors="replace").splitlines() if x]
        self._send(HTTPStatus.OK, response_envelope("capabilities", {"backend": status.get("backend", "unknown"), "capabilities": caps}))

    def _config(self, profile: str | None) -> None:
        self._send(HTTPStatus.OK, response_envelope("config", command_json(profile, "config", "export-typed")))

    def _events(self, profile: str | None) -> None:
        env = profile_env(profile)
        raw = subprocess.run(["bash", "-c", 'source "$1"; audit_list', "_", str(AUDIT_STORE)], cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False).stdout
        events = [json.loads(line) for line in raw.decode("utf-8").splitlines() if line]
        self._send(HTTPStatus.OK, response_envelope("events", events[-100:]))

    def _metrics(self, profile: str | None) -> None:
        body = b"# HELP proxy_agent_control_api_up Local Control API transport availability\nproxy_agent_control_api_up 1\n"
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _revisions(self, profile: str | None) -> None:
        names = revision_call(profile, "revision_list").decode("utf-8").splitlines()
        revisions = [int(name[:-5]) for name in names if name.endswith(".json") and name[:-5].isdigit()]
        self._send(HTTPStatus.OK, response_envelope("revisions", {"current": int(revision_call(profile, "revision_current")), "desired": int(revision_call(profile, "revision_desired_revision")), "revisions": revisions}))

    def _revision_detail(self, revision_id: str, profile: str | None) -> None:
        if not revision_id.isdigit():
            raise ValueError("revision must be an unsigned integer")
        self._send(HTTPStatus.OK, response_envelope("revision", json.loads(revision_call(profile, "revision_get", revision_id))))

    @staticmethod
    def _validate(body: Any) -> None:
        if not isinstance(body, dict) or not isinstance(body.get("config"), dict):
            raise ValidationError("body.config must be an object")
        cfg = body["config"]
        required = {"schema_version", "backend", "listeners", "health", "integrations", "routing", "security"}
        missing = sorted(required - cfg.keys())
        if missing:
            raise ValidationError(f"missing required config fields: {', '.join(missing)}")
        if cfg["schema_version"] != 1:
            raise ValidationError("schema_version must be 1")
        if not isinstance(cfg["backend"], dict) or not cfg["backend"].get("type"):
            raise ValidationError("backend.type is required")
        if not isinstance(cfg["security"], dict):
            raise ValidationError("security must be an object")
        if cfg["security"].get("allow_public_listener") is True:
            raise ValidationError("public listener policy requires an explicit authenticated deployment boundary")

    def _create_revision(self, body: Any, profile: str | None) -> None:
        self._validate(body)
        expected = body.get("if_match_revision")
        cfg = json.dumps(body["config"], ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        actor = str(body.get("actor") or "local-api")
        summary = str(body.get("change_summary") or "configuration change")
        if expected is None:
            rid = int(revision_call(profile, "revision_record", cfg, actor, summary, "passed", "pending"))
        else:
            rc, stdout, stderr = revision_call_rc(profile, "revision_record_if_match", str(expected), cfg, actor, summary, "passed", "pending")
            if rc == 3:
                raise ConflictError(stderr_message(stderr) or "revision head conflict")
            if rc != 0:
                raise RuntimeError(stderr_message(stderr) or "revision creation failed")
            rid = int(stdout)
        safe_audit(profile, {"schema_version": 1, "event": "revision.created", "revision": rid, "actor": actor, "timestamp": int(time.time()), "change_summary": summary})
        self._send(HTTPStatus.CREATED, response_envelope("revision", json.loads(revision_call(profile, "revision_get", str(rid)))))

    def _apply(self, body: Any, profile: str | None) -> None:
        revision = int(body.get("revision", 0)) if isinstance(body, dict) else 0
        expected = body.get("if_match_revision") if isinstance(body, dict) else None
        if revision <= 0:
            raise ValueError("revision is required")
        obj = json.loads(revision_call(profile, "revision_get", str(revision)))
        cfg = json.dumps(obj["config"], ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        if expected is None:
            revision_call(profile, "revision_set_desired", str(revision), cfg)
        else:
            rc, _, stderr = revision_call_rc(profile, "revision_set_desired_if_match", str(expected), str(revision), cfg)
            if rc == 3:
                raise ConflictError(stderr_message(stderr) or "revision head conflict")
            if rc != 0:
                raise RuntimeError(stderr_message(stderr) or "desired-state update failed")
        actor = str(body.get("actor") or "local-api")
        try:
            result = reconcile(profile, "--activate")
        except Exception as exc:
            message = str(exc)
            safe_audit(profile, {"schema_version": 1, "event": "desired_state.activation_failed", "revision": revision, "actor": actor, "timestamp": int(time.time()), "status": "failed", "error": message})
            raise ActivationError(message) from exc
        safe_audit(profile, {"schema_version": 1, "event": "desired_state.activated", "revision": revision, "actor": actor, "timestamp": int(time.time()), "status": result.get("status")})
        self._send(HTTPStatus.ACCEPTED, response_envelope("apply", {"revision": revision, "desired_revision": int(revision_call(profile, "revision_desired_revision")), "reconcile": result}))

    def _rollback(self, body: Any, profile: str | None) -> None:
        if not isinstance(body, dict) or not body.get("revision"):
            raise ValueError("revision is required")
        target = int(body["revision"])
        expected = body.get("if_match_revision")
        actor = str(body.get("actor") or "local-api")
        summary = f"rollback to revision {target}"
        if expected is None:
            obj = json.loads(revision_call(profile, "revision_get", str(target)))
            cfg = json.dumps(obj["config"], ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            rid = int(revision_call(profile, "revision_record", cfg, actor, summary, "passed", "pending"))
            revision_call(profile, "revision_set_desired", str(rid), cfg)
        else:
            rc, stdout, stderr = revision_call_rc(profile, "revision_rollback_if_match", str(expected), str(target), actor, summary)
            if rc == 3:
                raise ConflictError(stderr_message(stderr) or "revision head conflict")
            if rc != 0:
                raise RuntimeError(stderr_message(stderr) or "rollback revision creation failed")
            rid = int(stdout)
        try:
            result = reconcile(profile, "--activate")
        except Exception as exc:
            message = str(exc)
            safe_audit(profile, {"schema_version": 1, "event": "rollback.activation_failed", "revision": rid, "target_revision": target, "actor": actor, "timestamp": int(time.time()), "status": "failed", "error": message})
            raise ActivationError(message) from exc
        safe_audit(profile, {"schema_version": 1, "event": "rollback.activated", "revision": rid, "target_revision": target, "actor": actor, "timestamp": int(time.time()), "status": result.get("status")})
        self._send(HTTPStatus.ACCEPTED, response_envelope("rollback", {"revision": rid, "target_revision": target, "desired_revision": int(revision_call(profile, "revision_desired_revision")), "reconcile": result}))


class UnixHTTPServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="proxy-agent local Control API v1")
    parser.add_argument("--socket", default=os.environ.get("PA_API_SOCKET", "/run/proxy-agent/control.sock"))
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    socket_path = Path(args.socket)
    socket_path.parent.mkdir(parents=True, exist_ok=True)
    if socket_path.exists():
        if not stat.S_ISSOCK(socket_path.stat().st_mode):
            print(f"refusing to replace non-socket path: {socket_path}", file=sys.stderr)
            return 2
        socket_path.unlink()
    server = UnixHTTPServer(str(socket_path), ControlRequestHandler)
    os.chmod(socket_path, 0o600)
    print(f"control-api listening on {socket_path}", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        try:
            socket_path.unlink()
        except FileNotFoundError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
