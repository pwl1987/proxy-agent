#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/backend-capabilities.sh"
source "$ROOT/lib/backend.sh"
source "$ROOT/integrations/common.sh"
source "$ROOT/integrations/git.sh"
source "$ROOT/integrations/docker.sh"
source "$ROOT/integrations/pip.sh"
source "$ROOT/integrations/npm.sh"

load_config
backend_load

usage() {
  cat <<'EOF'
Usage: proxy-agent-integration <git|docker|pip|npm|all>

Print integration commands without mutating the host configuration.
Enable each integration in proxy-agent.conf with INTEGRATE_*="true".
EOF
}

print_one() {
  local app="$1"
  integration_enabled "$app" || {
    printf '# %s integration disabled (INTEGRATE_%s=false)\n' "$app" "${app^^}"
    return 0
  }
  printf '\n### %s ###\n' "$app"
  case "$app" in
    git) integration_git_print ;;
    docker) integration_docker_print ;;
    pip) integration_pip_print ;;
    npm) integration_npm_print ;;
  esac
}

case "${1:-}" in
  git|docker|pip|npm) print_one "$1" ;;
  all) for app in git docker pip npm; do print_one "$app"; done ;;
  *) usage; exit 2 ;;
esac
