#!/usr/bin/env python3
"""0.5.2 Web UI entrypoint reusing the authenticated Web Gateway control path."""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import ipaddress
import os
import ssl
from http import HTTPStatus
from http.server import ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CORE_PATH = Path(__file__).resolve().with_name("proxy-agent-web")
UI_PATH = ROOT / "web" / "index.html"


def load_core():
    loader = importlib.machinery.SourceFileLoader("proxy_agent_web_core", str(CORE_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("unable to load Web Gateway core")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


core = load_core()


def is_loopback(host: str) -> bool:
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return host in {"localhost", "ip6-localhost"}


class WebUIHandler(core.GatewayHandler):
    def _serve_ui(self) -> None:
        try:
            body = UI_PATH.read_bytes()
        except OSError as exc:
            self._send_error(HTTPStatus.INTERNAL_SERVER_ERROR, "ui_unavailable", str(exc))
            return
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in {"/", "/index.html"}:
            self._serve_ui()
            return
        super().do_GET()


class WebUIServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address: tuple[str, int], control_socket: str, admin_token: str, secure_cookies: bool) -> None:
        super().__init__(address, WebUIHandler)
        self.control = core.UnixHTTPClient(control_socket)
        self.admin_token = admin_token
        self.sessions = core.SessionStore()
        self.login_limiter = core.LoginRateLimiter()
        self.secure_cookies = secure_cookies


def main() -> int:
    parser = argparse.ArgumentParser(description="proxy-agent authenticated Web Gateway with 0.5.2 UI")
    parser.add_argument("--listen", default=os.environ.get("PA_WEB_LISTEN", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PA_WEB_PORT", "8443")))
    parser.add_argument("--control-socket", default=os.environ.get("PA_CONTROL_SOCKET", "/run/proxy-agent/control.sock"))
    parser.add_argument("--admin-token-file", required=True)
    parser.add_argument("--tls-cert", default=os.environ.get("PA_WEB_TLS_CERT"))
    parser.add_argument("--tls-key", default=os.environ.get("PA_WEB_TLS_KEY"))
    args = parser.parse_args()

    loopback = is_loopback(args.listen)
    if not loopback and (not args.tls_cert or not args.tls_key):
        parser.error("non-loopback management listener requires --tls-cert and --tls-key")
    if args.port < 1 or args.port > 65535:
        parser.error("port out of range")

    token = core.read_token(Path(args.admin_token_file).expanduser())
    secure_cookies = bool(args.tls_cert and args.tls_key)
    server = WebUIServer((args.listen, args.port), args.control_socket, token, secure_cookies)
    if secure_cookies:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(args.tls_cert, args.tls_key)
        server.socket = context.wrap_socket(server.socket, server_side=True)

    scheme = "https" if secure_cookies else "http"
    print(
        f"proxy-agent web UI listening on {scheme}://{args.listen}:{args.port} "
        f"sessions=enabled csrf=enabled login_rate_limit={core.LOGIN_LIMIT}/{core.LOGIN_WINDOW}s",
        flush=True,
    )
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
