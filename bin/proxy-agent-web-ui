#!/usr/bin/env python3
"""0.5.2 Web UI entrypoint reusing the authenticated Web Gateway control path."""
from __future__ import annotations

import argparse
import hmac
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import ssl
import time
from http import HTTPStatus
from http.server import ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CORE_PATH = Path(__file__).resolve().with_name("proxy-agent-web")
UI_PATH = ROOT / "web" / "index.html"
FORM_JS_PATH = ROOT / "web" / "config-form.js"
PROFILE_SELECTOR_JS_PATH = ROOT / "web" / "profile-selector.js"
CONFIG_FORM_SYNC_JS_PATH = ROOT / "web" / "config-form-sync.js"


def load_core():
    loader = importlib.machinery.SourceFileLoader("proxy_agent_web_core", str(CORE_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("unable to load Web Gateway core")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


core = load_core()
core.ALLOWED_GET_PREFIXES = core.ALLOWED_GET_PREFIXES + ("/api/v1/profiles",)


def is_loopback(host: str) -> bool:
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return host in {"localhost", "ip6-localhost"}


def parse_cidrs(values: list[str]) -> tuple[ipaddress._BaseNetwork, ...]:
    networks: list[ipaddress._BaseNetwork] = []
    for raw in values:
        for item in raw.split(","):
            item = item.strip()
            if not item:
                continue
            try:
                networks.append(ipaddress.ip_network(item, strict=False))
            except ValueError as exc:
                raise ValueError(f"invalid management ACL CIDR: {item}") from exc
    return tuple(networks)


class WebUIHandler(core.GatewayHandler):
    def _network_allowed(self) -> bool:
        networks = self.gateway.management_acl
        if not networks:
            return True
        peer = self.client_address[0] if self.client_address else ""
        try:
            address = ipaddress.ip_address(peer)
        except ValueError:
            return False
        return any(address in network for network in networks)

    def _require_network(self) -> bool:
        if self._network_allowed():
            return True
        self._send_error(HTTPStatus.FORBIDDEN, "network_not_allowed", "management source address is not allowed")
        return False

    def _audit_auth(self, event: str, status: str, reason: str | None = None) -> None:
        peer = self.client_address[0] if self.client_address else "unknown"
        payload = {
            "event": event,
            "status": status,
            "peer": peer,
            "timestamp": int(time.time()),
        }
        if reason:
            payload["reason"] = reason
        try:
            body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            status_code, response_body, _ = self.gateway.control.request("POST", "/api/v1/auth-events", body=body, content_type="application/json")
            if status_code not in {HTTPStatus.ACCEPTED, HTTPStatus.OK}:
                print(f"web-ui: auth audit rejected status={status_code} body={response_body[:256]!r}", flush=True)
        except Exception as exc:
            print(f"web-ui: auth audit failed: {exc}", flush=True)

    def _login(self) -> None:
        peer = self.client_address[0] if self.client_address else "unknown"
        if not self.gateway.login_limiter.allowed(peer):
            self._audit_auth("login.rate_limited", "blocked", "rate_limit")
            self._send_error(HTTPStatus.TOO_MANY_REQUESTS, "login_rate_limited", "too many login attempts")
            return
        try:
            body = self._read_json_body() or {}
            token = str(body.get("token", ""))
        except Exception:
            token = ""
        if not hmac.compare_digest(token, self.gateway.admin_token):
            self.gateway.login_limiter.record_failure(peer)
            self._audit_auth("login.failure", "failed", "invalid_credentials")
            self._send_error(HTTPStatus.UNAUTHORIZED, "invalid_credentials", "invalid credentials")
            return
        if not self._request_origin_valid():
            self._audit_auth("login.failure", "failed", "invalid_origin")
            self._send_error(HTTPStatus.FORBIDDEN, "invalid_origin", "request origin is not allowed")
            return
        session_id, csrf = self.gateway.sessions.create()
        self._audit_auth("login.success", "succeeded")
        payload = json.dumps({"authenticated": True, "csrf_token": csrf}, separators=(",", ":")).encode()
        self._send_json(HTTPStatus.OK, payload, [("Set-Cookie", self._set_session_cookie(session_id))])

    def do_POST(self) -> None:
        if not self._require_network():
            return
        path = self.path.split("?", 1)[0]
        if path == "/session/logout":
            session = self._session()
            if session is not None:
                self.gateway.sessions.delete(session[0])
                self._audit_auth("logout", "succeeded")
            self._send_json(HTTPStatus.NO_CONTENT, b"", [("Set-Cookie", self._clear_session_cookie())])
            return
        super().do_POST()

    def do_GET(self) -> None:
        if not self._require_network():
            return
        path = self.path.split("?", 1)[0]
        if path in {"/", "/index.html"}:
            self._serve_ui()
            return
        if path == "/config-form.js":
            self._send_static(FORM_JS_PATH, "text/javascript; charset=utf-8")
            return
        if path == "/profile-selector.js":
            self._send_static(PROFILE_SELECTOR_JS_PATH, "text/javascript; charset=utf-8")
            return
        if path == "/config-form-sync.js":
            self._send_static(CONFIG_FORM_SYNC_JS_PATH, "text/javascript; charset=utf-8")
            return
        super().do_GET()

    def do_PUT(self) -> None:
        if not self._require_network():
            return
        super().do_PUT()

    def do_DELETE(self) -> None:
        if not self._require_network():
            return
        super().do_DELETE()

    def do_PATCH(self) -> None:
        if not self._require_network():
            return
        super().do_PATCH()

    def _send_static(self, path: Path, content_type: str) -> None:
        try:
            body = path.read_bytes()
        except OSError as exc:
            self._send_error(HTTPStatus.INTERNAL_SERVER_ERROR, "ui_unavailable", str(exc))
            return
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _serve_ui(self) -> None:
        try:
            body = UI_PATH.read_text(encoding="utf-8")
            injection = '<script src="/config-form.js" defer></script><script src="/profile-selector.js" defer></script><script src="/config-form-sync.js" defer></script>'
            if injection not in body:
                body = body.replace("</head>", f"{injection}</head>", 1)
            payload = body.encode("utf-8")
        except OSError as exc:
            self._send_error(HTTPStatus.INTERNAL_SERVER_ERROR, "ui_unavailable", str(exc))
            return
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)


class WebUIServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address: tuple[str, int], control_socket: str, admin_token: str, secure_cookies: bool, management_acl: tuple[ipaddress._BaseNetwork, ...]) -> None:
        super().__init__(address, WebUIHandler)
        self.control = core.UnixHTTPClient(control_socket)
        self.admin_token = admin_token
        self.sessions = core.SessionStore()
        self.login_limiter = core.LoginRateLimiter()
        self.secure_cookies = secure_cookies
        self.management_acl = management_acl


def main() -> int:
    parser = argparse.ArgumentParser(description="proxy-agent authenticated Web Gateway with 0.5.2 UI")
    parser.add_argument("--listen", default=os.environ.get("PA_WEB_LISTEN", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PA_WEB_PORT", "8443")))
    parser.add_argument("--control-socket", default=os.environ.get("PA_CONTROL_SOCKET", "/run/proxy-agent/control.sock"))
    parser.add_argument("--admin-token-file", required=True)
    parser.add_argument("--tls-cert", default=os.environ.get("PA_WEB_TLS_CERT"))
    parser.add_argument("--tls-key", default=os.environ.get("PA_WEB_TLS_KEY"))
    parser.add_argument("--allow-cidr", action="append", default=None, help="allow a management source CIDR; repeat or use comma-separated values")
    args = parser.parse_args()

    loopback = is_loopback(args.listen)
    if not loopback and (not args.tls_cert or not args.tls_key):
        parser.error("non-loopback management listener requires --tls-cert and --tls-key")
    if args.port < 1 or args.port > 65535:
        parser.error("port out of range")

    raw_acl = args.allow_cidr if args.allow_cidr is not None else ([os.environ["PA_WEB_ALLOW_CIDRS"]] if os.environ.get("PA_WEB_ALLOW_CIDRS") else [])
    try:
        management_acl = parse_cidrs(raw_acl)
    except ValueError as exc:
        parser.error(str(exc))
    if not loopback and not management_acl:
        parser.error("non-loopback management listener requires at least one --allow-cidr or PA_WEB_ALLOW_CIDRS entry")

    token = core.read_token(Path(args.admin_token_file).expanduser())
    secure_cookies = bool(args.tls_cert and args.tls_key)
    server = WebUIServer((args.listen, args.port), args.control_socket, token, secure_cookies, management_acl)
    if secure_cookies:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(args.tls_cert, args.tls_key)
        server.socket = context.wrap_socket(server.socket, server_side=True)

    scheme = "https" if secure_cookies else "http"
    acl_text = ",".join(str(network) for network in management_acl) or "unrestricted(loopback-only listener)"
    print(
        f"proxy-agent web UI listening on {scheme}://{args.listen}:{args.port} "
        f"sessions=enabled csrf=enabled login_rate_limit={core.LOGIN_LIMIT}/{core.LOGIN_WINDOW}s acl={acl_text}",
        flush=True,
    )
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
