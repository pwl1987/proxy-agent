#!/usr/bin/env python3
"""Minimal 0.5.2 Web Gateway: authenticated read-only facade over Control API v1."""
from __future__ import annotations

import argparse
import ipaddress
import os
import ssl
import socket
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent.parent
MAX_RESPONSE = 4 * 1024 * 1024
ALLOWED_GET_PREFIXES = (
    "/api/v1/status",
    "/api/v1/health",
    "/api/v1/metrics",
    "/api/v1/capabilities",
    "/api/v1/config",
    "/api/v1/events",
    "/api/v1/revisions",
)


def is_loopback(host: str) -> bool:
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return host in {"localhost", "ip6-localhost"}


def read_token(path: Path) -> str:
    value = path.read_text(encoding="utf-8").strip()
    if not value:
        raise ValueError("admin token file is empty")
    return value


class UnixHTTPClient:
    def __init__(self, socket_path: str) -> None:
        self.socket_path = socket_path

    def get(self, target: str) -> tuple[int, bytes, list[tuple[str, str]]]:
        request = (
            f"GET {target} HTTP/1.1\r\n"
            f"Host: proxy-agent-control\r\n"
            f"Connection: close\r\n\r\n"
        ).encode("ascii")
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(10)
        try:
            sock.connect(self.socket_path)
            sock.sendall(request)
            chunks: list[bytes] = []
            total = 0
            while True:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_RESPONSE:
                    raise RuntimeError("control API response too large")
                chunks.append(chunk)
        finally:
            sock.close()
        raw = b"".join(chunks)
        head, sep, body = raw.partition(b"\r\n\r\n")
        if not sep:
            raise RuntimeError("invalid control API response")
        lines = head.decode("iso-8859-1").split("\r\n")
        if not lines or len(lines[0].split()) < 2:
            raise RuntimeError("invalid control API status line")
        status = int(lines[0].split()[1])
        headers: list[tuple[str, str]] = []
        for line in lines[1:]:
            if ":" in line:
                name, value = line.split(":", 1)
                if name.lower() in {"content-type", "cache-control"}:
                    headers.append((name, value.strip()))
        return status, body, headers


class GatewayHandler(BaseHTTPRequestHandler):
    server_version = "proxy-agent-web/0.5.2"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args: object) -> None:
        print(f"web-gateway: {fmt % args}", flush=True)

    @property
    def gateway(self) -> "GatewayServer":
        return self.server  # type: ignore[return-value]

    def _send_json_error(self, status: HTTPStatus, code: str, message: str) -> None:
        body = (
            '{"api_version":"v1","error":'
            f'{{"code":"{code}","message":"{message}"}}'
            '}'
        ).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self) -> bool:
        expected = self.gateway.admin_token
        provided = self.headers.get("Authorization", "")
        return provided.startswith("Bearer ") and provided[7:] == expected

    def do_GET(self) -> None:
        path = urlsplit(self.path).path
        if path == "/healthz":
            body = b'{"status":"ok","gateway":"ready"}'
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if not any(path == p or path.startswith(p + "/") for p in ALLOWED_GET_PREFIXES):
            self._send_json_error(HTTPStatus.NOT_FOUND, "not_found", "unknown gateway endpoint")
            return
        if not self._authorized():
            self.send_response(HTTPStatus.UNAUTHORIZED)
            self.send_header("WWW-Authenticate", 'Bearer realm="proxy-agent"')
            self.send_header("Content-Length", "0")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        try:
            status, body, headers = self.gateway.control.get(self.path)
        except Exception as exc:
            self._send_json_error(HTTPStatus.BAD_GATEWAY, "control_api_unavailable", str(exc))
            return
        self.send_response(status)
        for name, value in headers:
            self.send_header(name, value)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        self._send_json_error(HTTPStatus.METHOD_NOT_ALLOWED, "read_only_gateway", "mutating routes are not enabled in the gateway foundation")

    def do_PUT(self) -> None:
        self.do_POST()

    def do_DELETE(self) -> None:
        self.do_POST()

    def do_PATCH(self) -> None:
        self.do_POST()


class GatewayServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address: tuple[str, int], control_socket: str, admin_token: str) -> None:
        super().__init__(address, GatewayHandler)
        self.control = UnixHTTPClient(control_socket)
        self.admin_token = admin_token


def main() -> int:
    parser = argparse.ArgumentParser(description="proxy-agent authenticated Web Gateway")
    parser.add_argument("--listen", default=os.environ.get("PA_WEB_LISTEN", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PA_WEB_PORT", "8443")))
    parser.add_argument("--control-socket", default=os.environ.get("PA_CONTROL_SOCKET", "/run/proxy-agent/control.sock"))
    parser.add_argument("--admin-token-file", required=True)
    parser.add_argument("--tls-cert", default=os.environ.get("PA_WEB_TLS_CERT"))
    parser.add_argument("--tls-key", default=os.environ.get("PA_WEB_TLS_KEY"))
    args = parser.parse_args()

    host = args.listen
    loopback = is_loopback(host)
    if not loopback and (not args.tls_cert or not args.tls_key):
        parser.error("non-loopback management listener requires --tls-cert and --tls-key")
    if args.port < 1 or args.port > 65535:
        parser.error("port out of range")

    token = read_token(Path(args.admin_token_file).expanduser())
    server = GatewayServer((host, args.port), args.control_socket, token)
    if args.tls_cert and args.tls_key:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(args.tls_cert, args.tls_key)
        server.socket = context.wrap_socket(server.socket, server_side=True)
    elif not loopback:
        parser.error("TLS is required for non-loopback listener")

    scheme = "https" if args.tls_cert else "http"
    print(f"proxy-agent web gateway listening on {scheme}://{host}:{args.port}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
