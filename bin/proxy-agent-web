#!/usr/bin/env python3
"""Authenticated 0.5.2 Web Gateway over the local Control API v1."""
from __future__ import annotations

import argparse
import hmac
import ipaddress
import json
import os
import secrets
import socket
import ssl
import threading
import time
from collections import defaultdict, deque
from http import HTTPStatus
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

MAX_BODY = 1024 * 1024
MAX_RESPONSE = 4 * 1024 * 1024
SESSION_TTL = 30 * 60
MAX_SESSIONS = 256
LOGIN_WINDOW = 60
LOGIN_LIMIT = 5
SESSION_COOKIE = "proxy_agent_session"
ALLOWED_GET_PREFIXES = (
    "/api/v1/status",
    "/api/v1/health",
    "/api/v1/metrics",
    "/api/v1/capabilities",
    "/api/v1/config",
    "/api/v1/events",
    "/api/v1/revisions",
)
ALLOWED_POST_PATHS = {
    "/api/v1/validate",
    "/api/v1/revisions",
    "/api/v1/apply",
    "/api/v1/rollback",
    "/api/v1/runtime/start",
    "/api/v1/runtime/stop",
    "/api/v1/runtime/restart",
    "/api/v1/runtime/test",
    "/api/v1/runtime/diagnose",
}


def is_loopback(host: str) -> bool:
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return host in {"localhost", "ip6-localhost"}


def read_token(path: Path) -> str:
    value = path.read_text(encoding="utf-8").strip()
    if not value:
        raise ValueError("admin token file is empty")
    return value


class LoginRateLimiter:
    def __init__(self, limit: int = LOGIN_LIMIT, window: int = LOGIN_WINDOW) -> None:
        self.limit = limit
        self.window = window
        self._attempts: dict[str, deque[float]] = defaultdict(deque)
        self._lock = threading.Lock()

    def allowed(self, key: str, now: float | None = None) -> bool:
        current = time.monotonic() if now is None else now
        with self._lock:
            bucket = self._attempts[key]
            while bucket and current - bucket[0] >= self.window:
                bucket.popleft()
            return len(bucket) < self.limit

    def record_failure(self, key: str, now: float | None = None) -> None:
        current = time.monotonic() if now is None else now
        with self._lock:
            bucket = self._attempts[key]
            while bucket and current - bucket[0] >= self.window:
                bucket.popleft()
            bucket.append(current)


class SessionStore:
    def __init__(self, ttl: int = SESSION_TTL, max_sessions: int = MAX_SESSIONS) -> None:
        self.ttl = ttl
        self.max_sessions = max_sessions
        self._sessions: dict[str, tuple[str, float]] = {}
        self._lock = threading.Lock()

    def create(self) -> tuple[str, str]:
        now = time.monotonic()
        session_id = secrets.token_urlsafe(32)
        csrf = secrets.token_urlsafe(32)
        with self._lock:
            self._purge(now)
            if len(self._sessions) >= self.max_sessions:
                oldest = min(self._sessions, key=lambda key: self._sessions[key][1])
                del self._sessions[oldest]
            self._sessions[session_id] = (csrf, now + self.ttl)
        return session_id, csrf

    def get(self, session_id: str | None) -> tuple[str, str] | None:
        if not session_id:
            return None
        now = time.monotonic()
        with self._lock:
            self._purge(now)
            record = self._sessions.get(session_id)
            if record is None:
                return None
            csrf, _ = record
            self._sessions[session_id] = (csrf, now + self.ttl)
            return session_id, csrf

    def delete(self, session_id: str | None) -> None:
        if not session_id:
            return
        with self._lock:
            self._sessions.pop(session_id, None)

    def _purge(self, now: float) -> None:
        expired = [key for key, (_, expires_at) in self._sessions.items() if expires_at <= now]
        for key in expired:
            self._sessions.pop(key, None)


class UnixHTTPClient:
    def __init__(self, socket_path: str) -> None:
        self.socket_path = socket_path

    def request(
        self,
        method: str,
        target: str,
        body: bytes = b"",
        content_type: str | None = None,
    ) -> tuple[int, bytes, list[tuple[str, str]]]:
        headers = [
            f"{method} {target} HTTP/1.1",
            "Host: proxy-agent-control",
            "Connection: close",
        ]
        if body:
            headers.append(f"Content-Length: {len(body)}")
            headers.append(f"Content-Type: {content_type or 'application/json'}")
        raw_request = ("\r\n".join(headers) + "\r\n\r\n").encode("ascii") + body
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(10)
        try:
            sock.connect(self.socket_path)
            sock.sendall(raw_request)
            chunks: list[bytes] = []
            total = 0
            while True:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_RESPONSE:
                    raise RuntimeError("control API response too large")
                chunks.append(chunk)
        finally:
            sock.close()
        raw = b"".join(chunks)
        head, sep, response_body = raw.partition(b"\r\n\r\n")
        if not sep:
            raise RuntimeError("invalid control API response")
        lines = head.decode("iso-8859-1").split("\r\n")
        if not lines or len(lines[0].split()) < 2:
            raise RuntimeError("invalid control API status line")
        status = int(lines[0].split()[1])
        response_headers: list[tuple[str, str]] = []
        for line in lines[1:]:
            if ":" in line:
                name, value = line.split(":", 1)
                if name.lower() in {"content-type", "cache-control"}:
                    response_headers.append((name, value.strip()))
        return status, response_body, response_headers


class GatewayHandler(BaseHTTPRequestHandler):
    server_version = "proxy-agent-web/0.5.2"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args: object) -> None:
        peer = self.client_address[0] if self.client_address else "-"
        print(f"web-gateway: peer={peer} {fmt % args}", flush=True)

    @property
    def gateway(self) -> "GatewayServer":
        return self.server  # type: ignore[return-value]

    def _send_json(self, status: HTTPStatus, payload: bytes, extra_headers: list[tuple[str, str]] | None = None) -> None:
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        for name, value in extra_headers or []:
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(payload)

    def _send_error(self, status: HTTPStatus, code: str, message: str) -> None:
        payload = {"api_version": "v1", "error": {"code": code, "message": message}}
        self._send_json(status, json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))

    def _read_json_body(self) -> dict | None:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError as exc:
            raise ValueError("invalid Content-Length") from exc
        if length < 0 or length > MAX_BODY:
            raise ValueError("request body too large")
        raw = self.rfile.read(length)
        if len(raw) != length:
            raise ValueError("short request body")
        if not raw:
            return None
        value = json.loads(raw.decode("utf-8"))
        if not isinstance(value, dict):
            raise ValueError("JSON body must be an object")
        return value

    def _request_origin_valid(self) -> bool:
        origin = self.headers.get("Origin")
        if not origin:
            referer = self.headers.get("Referer")
            if not referer:
                return True
            referer_parts = urlsplit(referer)
            origin = f"{referer_parts.scheme}://{referer_parts.netloc}"
        expected = f"{'https' if self.gateway.secure_cookies else 'http'}://{self.headers.get('Host', '')}"
        return hmac.compare_digest(origin, expected)

    def _cookie_session_id(self) -> str | None:
        cookie = SimpleCookie()
        try:
            cookie.load(self.headers.get("Cookie", ""))
        except Exception:
            return None
        morsel = cookie.get(SESSION_COOKIE)
        return morsel.value if morsel else None

    def _session(self) -> tuple[str, str] | None:
        return self.gateway.sessions.get(self._cookie_session_id())

    def _bearer_authorized(self) -> bool:
        provided = self.headers.get("Authorization", "")
        return provided.startswith("Bearer ") and hmac.compare_digest(provided[7:], self.gateway.admin_token)

    def _authenticated_read(self) -> bool:
        return self._bearer_authorized() or self._session() is not None

    def _require_session(self) -> tuple[str, str] | None:
        session = self._session()
        if session is None:
            self._send_error(HTTPStatus.UNAUTHORIZED, "session_required", "valid session required")
            return None
        if not self._request_origin_valid():
            self._send_error(HTTPStatus.FORBIDDEN, "invalid_origin", "request origin is not allowed")
            return None
        session_id, csrf = session
        provided = self.headers.get("X-CSRF-Token", "")
        if not provided or not hmac.compare_digest(provided, csrf):
            self._send_error(HTTPStatus.FORBIDDEN, "csrf_failed", "valid CSRF token required")
            return None
        return session_id, csrf

    def _set_session_cookie(self, session_id: str) -> str:
        secure = "; Secure" if self.gateway.secure_cookies else ""
        return f"{SESSION_COOKIE}={session_id}; Path=/; HttpOnly; SameSite=Strict{secure}"

    def _clear_session_cookie(self) -> str:
        secure = "; Secure" if self.gateway.secure_cookies else ""
        return f"{SESSION_COOKIE}=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict{secure}"

    def do_GET(self) -> None:
        path = urlsplit(self.path).path
        if path == "/healthz":
            self._send_json(HTTPStatus.OK, b'{"status":"ok","gateway":"ready"}')
            return
        if path == "/session":
            session = self._session()
            if session is None:
                self._send_error(HTTPStatus.UNAUTHORIZED, "session_required", "valid session required")
                return
            session_id, csrf = session
            self._send_json(
                HTTPStatus.OK,
                json.dumps(
                    {"authenticated": True, "csrf_token": csrf, "session": session_id[:8] + "…"},
                    ensure_ascii=False,
                    separators=(",", ":"),
                ).encode("utf-8"),
            )
            return
        if not any(path == p or path.startswith(p + "/") for p in ALLOWED_GET_PREFIXES):
            self._send_error(HTTPStatus.NOT_FOUND, "not_found", "unknown gateway endpoint")
            return
        if not self._authenticated_read():
            self.send_response(HTTPStatus.UNAUTHORIZED)
            self.send_header("WWW-Authenticate", 'Bearer realm="proxy-agent"')
            self.send_header("Content-Length", "0")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        try:
            status, body, headers = self.gateway.control.request("GET", self.path)
        except Exception as exc:
            self._send_error(HTTPStatus.BAD_GATEWAY, "control_api_unavailable", str(exc))
            return
        self.send_response(status)
        for name, value in headers:
            self.send_header(name, value)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        path = urlsplit(self.path).path
        if path == "/session/login":
            self._login()
            return
        if path == "/session/logout":
            session = self._session()
            if session is not None:
                self.gateway.sessions.delete(session[0])
            self._send_json(HTTPStatus.NO_CONTENT, b"", [("Set-Cookie", self._clear_session_cookie())])
            return
        if path not in ALLOWED_POST_PATHS:
            self._send_error(HTTPStatus.NOT_FOUND, "not_found", "unknown gateway endpoint")
            return
        if self._require_session() is None:
            return
        try:
            raw_length = int(self.headers.get("Content-Length", "0"))
            if raw_length < 0 or raw_length > MAX_BODY:
                raise ValueError("request body too large")
            body = self.rfile.read(raw_length)
            if len(body) != raw_length:
                raise ValueError("short request body")
            status, response_body, headers = self.gateway.control.request(
                "POST",
                self.path,
                body=body,
                content_type=self.headers.get("Content-Type", "application/json"),
            )
        except ValueError as exc:
            self._send_error(HTTPStatus.BAD_REQUEST, "invalid_request", str(exc))
            return
        except Exception as exc:
            self._send_error(HTTPStatus.BAD_GATEWAY, "control_api_unavailable", str(exc))
            return
        self.send_response(status)
        for name, value in headers:
            self.send_header(name, value)
        self.send_header("Content-Length", str(len(response_body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(response_body)

    def _login(self) -> None:
        peer = self.client_address[0] if self.client_address else "unknown"
        if not self.gateway.login_limiter.allowed(peer):
            self._send_error(HTTPStatus.TOO_MANY_REQUESTS, "login_rate_limited", "too many login attempts")
            return
        try:
            body = self._read_json_body() or {}
            token = str(body.get("token", ""))
        except Exception:
            token = ""
        if not hmac.compare_digest(token, self.gateway.admin_token):
            self.gateway.login_limiter.record_failure(peer)
            self._send_error(HTTPStatus.UNAUTHORIZED, "invalid_credentials", "invalid credentials")
            return
        if not self._request_origin_valid():
            self._send_error(HTTPStatus.FORBIDDEN, "invalid_origin", "request origin is not allowed")
            return
        session_id, csrf = self.gateway.sessions.create()
        payload = json.dumps({"authenticated": True, "csrf_token": csrf}, separators=(",", ":")).encode()
        self._send_json(HTTPStatus.OK, payload, [("Set-Cookie", self._set_session_cookie(session_id))])

    def do_PUT(self) -> None:
        self._method_not_allowed()

    def do_DELETE(self) -> None:
        self._method_not_allowed()

    def do_PATCH(self) -> None:
        self._method_not_allowed()

    def _method_not_allowed(self) -> None:
        self._send_error(HTTPStatus.METHOD_NOT_ALLOWED, "method_not_allowed", "method is not enabled by the gateway")


class GatewayServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address: tuple[str, int], control_socket: str, admin_token: str, secure_cookies: bool) -> None:
        super().__init__(address, GatewayHandler)
        self.control = UnixHTTPClient(control_socket)
        self.admin_token = admin_token
        self.sessions = SessionStore()
        self.login_limiter = LoginRateLimiter()
        self.secure_cookies = secure_cookies


def main() -> int:
    parser = argparse.ArgumentParser(description="proxy-agent authenticated Web Gateway")
    parser.add_argument("--listen", default=os.environ.get("PA_WEB_LISTEN", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PA_WEB_PORT", "8443")))
    parser.add_argument("--control-socket", default=os.environ.get("PA_CONTROL_SOCKET", "/run/proxy-agent/control.sock"))
    parser.add_argument("--admin-token-file", required=True)
    parser.add_argument("--tls-cert", default=os.environ.get("PA_WEB_TLS_CERT"))
    parser.add_argument("--tls-key", default=os.environ.get("PA_WEB_TLS_KEY"))
    args = parser.parse_args()

    host = args.listen
    loopback = is_loopback(host)
    if not loopback and (not args.tls_cert or not args.tls_key):
        parser.error("non-loopback management listener requires --tls-cert and --tls-key")
    if args.port < 1 or args.port > 65535:
        parser.error("port out of range")

    token = read_token(Path(args.admin_token_file).expanduser())
    secure_cookies = bool(args.tls_cert and args.tls_key)
    server = GatewayServer((host, args.port), args.control_socket, token, secure_cookies)
    if secure_cookies:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(args.tls_cert, args.tls_key)
        server.socket = context.wrap_socket(server.socket, server_side=True)

    scheme = "https" if secure_cookies else "http"
    print(
        f"proxy-agent web gateway listening on {scheme}://{host}:{args.port} "
        f"sessions=enabled csrf=enabled login_rate_limit={LOGIN_LIMIT}/{LOGIN_WINDOW}s",
        flush=True,
    )
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
