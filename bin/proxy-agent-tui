#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH")"; fi
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT/lib/common.sh"
PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || { echo '用法: proxy-agent-tui [--profile 名称]' >&2; exit 2; }
  PROFILE_NAME="$2"; shift 2
fi
[[ $# -eq 0 ]] || { echo '用法: proxy-agent-tui [--profile 名称]' >&2; exit 2; }
[[ -t 0 && -t 1 ]] || { echo '错误：proxy-agent-tui 需要交互式终端' >&2; exit 1; }
command -v tput >/dev/null 2>&1 || { echo '错误：proxy-agent-tui 需要 tput' >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo '错误：proxy-agent-tui 需要 curl' >&2; exit 1; }

API_SOCKET="${PA_API_SOCKET:-/run/proxy-agent/control.sock}"
CLI=("$ROOT/bin/proxy-ctl")

api_get() {
  local path="$1"
  if [[ -n "$PROFILE_NAME" ]]; then
    curl --silent --show-error --fail --unix-socket "$API_SOCKET" --get --data-urlencode "profile=$PROFILE_NAME" "http://localhost$path"
  else
    curl --silent --show-error --fail --unix-socket "$API_SOCKET" "http://localhost$path"
  fi
}

api_runtime() {
  local action="$1" body='{}'
  [[ -n "$PROFILE_NAME" ]] && body="$(printf '{"profile":"%s"}' "$PROFILE_NAME")"
  curl --silent --show-error --fail --unix-socket "$API_SOCKET" -H 'Content-Type: application/json' -X POST --data "$body" "http://localhost/api/v1/runtime/$action"
}

build_cli() {
  CLI=("$ROOT/bin/proxy-ctl")
  [[ -n "$PROFILE_NAME" ]] && CLI+=(--profile "$PROFILE_NAME")
}
build_cli

cols() { tput cols 2>/dev/null || printf '80'; }
cleanup() { tput cnorm 2>/dev/null || true; tput sgr0 2>/dev/null || true; tput rmcup 2>/dev/null || true; printf '\n'; }
trap cleanup EXIT INT TERM
tput smcup
tput civis

action_label() {
  case "$1" in
    start) printf '启动' ;; stop) printf '停止' ;; restart) printf '重启' ;; test) printf '连通性测试' ;; diagnose) printf '诊断' ;; *) printf '%s' "$1" ;;
  esac
}

run_action() {
  local action="$1"
  tput cup 0 0; tput ed
  printf 'proxy-agent 操作：%s%s\n\n' "$(action_label "$action")" "${PROFILE_NAME:+（配置档案：$PROFILE_NAME）}"
  if output="$(api_runtime "$action" 2>&1)"; then
    printf '%s\n\n操作完成。按任意键返回。\n' "$output"
  else
    printf '%s\n\n操作失败。按任意键返回。\n' "$output"
  fi
  read -rsn1
}

health_summary() {
  local raw
  if raw="$(api_get /api/v1/health 2>/dev/null)"; then
    python3 -c 'import json,sys; d=json.load(sys.stdin)["data"]; print({"ready":"正常","not_ready":"未就绪"}.get(d.get("readiness"), d.get("status","未知")))' <<<"$raw"
  else
    printf 'API不可用'
  fi
}

status_summary() {
  local raw
  raw="$(api_get /api/v1/status 2>/dev/null)" || { printf 'proxy-agent 状态不可用'; return; }
  python3 -c '
import json,sys
d=json.load(sys.stdin)["data"]
print("proxy-agent")
print("  backend: " + ("listening" if d.get("backend_status") == "listening" else "not listening"))
print("  HTTP:     " + ("listening" if d.get("http_status") == "listening" else ("disabled" if d.get("http_status") == "disabled" else "not listening")))
print("  endpoint: " + str(d.get("endpoint","unknown")))
print("  profile: " + str(d.get("profile", "default")))
print("  desired revision: " + str(d.get("desired_revision", 0)))
print("  observed revision: " + str(d.get("control",{}).get("observed_revision", 0)))
' <<<"$raw"
}

translate_status_line() {
  local line="$1"
  case "$line" in
    'proxy-agent') printf 'proxy-agent' ;;
    '  backend: listening') printf '  后端状态: 正常监听' ;;
    '  backend: not listening') printf '  后端状态: 未监听' ;;
    '  HTTP:     listening') printf '  HTTP状态:  正常监听' ;;
    '  HTTP:     not listening') printf '  HTTP状态:  未监听' ;;
    '  HTTP:     disabled') printf '  HTTP状态:  已禁用' ;;
    '  endpoint: '*) printf '  endpoint:  %s' "${line#'  endpoint: '}" ;;
    '  profile: '*) printf '  配置档案:  %s' "${line#'  profile: '}" ;;
    '  desired revision: '*) printf '  期望版本:  %s' "${line#'  desired revision: '}" ;;
    '  observed revision: '*) printf '  实际版本:  %s' "${line#'  observed revision: '}" ;;
    *) printf '%s' "$line" ;;
  esac
}

render() {
  local width now status health route_info profile_label line
  width="$(cols)"; now="$(date '+%Y-%m-%d %H:%M:%S')"
  status="$(status_summary)"; health="$(health_summary)"; route_info="$("${CLI[@]}" route github.com 2>/dev/null || printf '未知')"
  profile_label="${PROFILE_NAME:-默认}"
  tput cup 0 0; tput ed
  printf '╭%*s╮\n' "$((width-2))" '' | tr ' ' '─'
  printf '│  proxy-agent 代理控制台%-*s│\n' "$((width-25))" ''
  printf '│  配置档案: %-*s│\n' "$((width-13))" "$profile_label"
  printf '│  时间: %s%-*s│\n' "$now" "$((width-28))" ''
  printf '├%*s┤\n' "$((width-2))" '' | tr ' ' '─'
  printf '│ %-*s│\n' "$((width-2))" '运行状态'
  while IFS= read -r line; do translate_status_line "$line"; printf '\n'; done <<< "$status"
  printf '│ %-*s│\n' "$((width-2))" "健康状态: $health"
  printf '│ %-*s│\n' "$((width-2))" "分流结果: $route_info"
  printf '├%*s┤\n' "$((width-2))" '' | tr ' ' '─'
  printf '│ %-*s│\n' "$((width-2))" '快捷操作'
  printf '│ %-*s│\n' "$((width-2))" '[s] 启动  [x] 停止  [r] 重启  [t] 测试  [d] 诊断'
  printf '│ %-*s│\n' "$((width-2))" '[i] 集成  [R] 分流查询  [p] 切换配置档案  [q] 退出  [Enter] 刷新'
  printf '│ %-*s│\n' "$((width-2))" '自动刷新：2 秒'
  printf '╰%*s╯\n' "$((width-2))" '' | tr ' ' '─'
}

route_prompt() {
  tput cup 0 0; tput ed; printf '输入主机名或 IPv4 查询分流：'
  local target; IFS= read -r target; [[ -n "$target" ]] || return
  printf '\n%s\n\n按任意键返回。' "$("${CLI[@]}" route "$target" 2>&1 || true)"; read -rsn1
}

integration_view() { tput cup 0 0; tput ed; printf '应用集成配置\n\n'; "${CLI[@]}" integration all 2>&1 || true; printf '\n按任意键返回。'; read -rsn1; }

profile_select() {
  local current="${PROFILE_NAME:-default}" choice
  mapfile -t profiles < <("$ROOT/bin/proxy-ctl" profiles list 2>/dev/null || true)
  tput cup 0 0; tput ed
  printf '可用配置档案（当前：%s）\n\n' "$([[ "$current" == default ]] && printf '默认' || printf '%s' "$current")"
  printf 'default  （默认）\n'
  local item
  for item in "${profiles[@]}"; do [[ -n "$item" && "$item" != "$current" ]] && printf '%s\n' "$item"; done
  printf '\n输入配置档案名称（留空 = 默认）：'
  IFS= read -r choice
  if [[ -z "$choice" || "$choice" == default ]]; then PROFILE_NAME=''; else
    if ! printf '%s\n' "${profiles[@]}" | grep -Fqx -- "$choice"; then printf '\n未知配置档案。按任意键返回。'; read -rsn1; return; fi
    PROFILE_NAME="$choice"
  fi
  build_cli
}

while true; do
  render
  IFS= read -rsn1 -t 2 key || key=''
  case "$key" in
    s) run_action start ;; x) run_action stop ;; r) run_action restart ;; t) run_action test ;; d) run_action diagnose ;;
    i) integration_view ;; R) route_prompt ;; p) profile_select ;; q) exit 0 ;; '') ;;
  esac
done
