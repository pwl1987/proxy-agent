#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/profile.sh"

PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || die 'usage: proxy-agent-health [--profile <name>]'
  PROFILE_NAME="$2"
  shift 2
fi
[[ $# -eq 0 ]] || die "usage: proxy-agent-health [--profile <name>]"

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME"
  PA_STATE_DIR="${PA_STATE_DIR:-/run/proxy-agent}/${PROFILE_NAME}"
  apply_config_defaults
else
  load_config
fi

sync_runtime_state() {
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" status --json=v2 >/dev/null 2>&1 || true
  else
    "$ROOT/bin/proxy-ctl" status --json=v2 >/dev/null 2>&1 || true
  fi
}

attempt_test() {
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" test
  else
    "$ROOT/bin/proxy-ctl" test
  fi
}

retries="${HEALTH_RETRIES:-2}"
backoff="${HEALTH_BACKOFF:-2}"
attempt=1

while (( attempt <= retries + 1 )); do
  if attempt_test; then
    mkdir -p "$PA_STATE_DIR"
    date +%s >"$PA_STATE_DIR/healthy"
    sync_runtime_state
    exit 0
  fi
  if (( attempt <= retries )); then
    sleep "$((backoff * attempt))"
  fi
  ((attempt += 1))
done

mkdir -p "$PA_STATE_DIR"
date +%s >"$PA_STATE_DIR/unhealthy"
sync_runtime_state
warn "proxy health check failed after $((retries + 1)) attempt(s)"

if [[ "${HEALTH_AUTO_RECOVER:-true}" == "true" ]]; then
  warn 'attempting automatic recovery'
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" restart
  else
    "$ROOT/bin/proxy-ctl" restart
  fi
  if attempt_test; then
    date +%s >"$PA_STATE_DIR/recovered"
    sync_runtime_state
    log 'automatic recovery succeeded'
    exit 0
  fi
  sync_runtime_state
  warn 'automatic recovery failed'
fi

exit 1
