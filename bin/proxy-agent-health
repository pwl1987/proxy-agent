#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH")"
fi
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/profile.sh"
source "$ROOT/lib/backend-capabilities.sh"
source "$ROOT/lib/backend.sh"
source "$ROOT/lib/route.sh"
source "$ROOT/lib/config.sh"
source "$ROOT/lib/health.sh"
source "$ROOT/lib/state.sh"

PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || die 'usage: proxy-agent-health [--profile <name>]'
  PROFILE_NAME="$2"
  shift 2
fi
[[ $# -eq 0 ]] || die 'usage: proxy-agent-health [--profile <name>]'

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME"
  if [[ "${PA_STATE_DIR_EXPLICIT:-false}" != true ]]; then
    PA_STATE_DIR="${PA_STATE_DIR}/${PROFILE_NAME}"
  fi
  if [[ "${PA_LOG_DIR_EXPLICIT:-false}" != true ]]; then
    PA_LOG_DIR="${PA_LOG_DIR}/${PROFILE_NAME}"
  fi
  apply_config_defaults
else
  load_config
fi

backend_load

liveness_ok() {
  backend_liveness >/dev/null 2>&1
}

network_ok() {
  health_network_status >/dev/null 2>&1
}

health_check() {
  HEALTH_LAST_PATH_DETAIL="$(backend_health_detail)"
  HEALTH_LAST_PATH_REASON="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason", "unknown"))' <<<"$HEALTH_LAST_PATH_DETAIL")"
  if ! liveness_ok; then
    return 10
  fi
  if [[ "${HEALTH_NETWORK_REQUIRED:-false}" == true ]]; then
    network_ok || return 20
  elif [[ -n "${HEALTH_TARGETS:-}" ]]; then
    network_ok || return 30
  fi
}

restart_agent() {
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" restart
  else
    "$ROOT/bin/proxy-ctl" restart
  fi
}

sync_runtime_state() {
  if [[ -n "$PROFILE_NAME" ]]; then
    PA_HEALTH_PATH_DETAIL="$HEALTH_LAST_PATH_DETAIL" "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" status --json=v2 >/dev/null 2>&1 || true
  else
    PA_HEALTH_PATH_DETAIL="$HEALTH_LAST_PATH_DETAIL" "$ROOT/bin/proxy-ctl" status --json=v2 >/dev/null 2>&1 || true
  fi
}

retries="${HEALTH_RETRIES:-2}"
backoff="${HEALTH_BACKOFF:-2}"
attempt=1
last_rc=1
HEALTH_LAST_PATH_DETAIL='{"transport_status":"unknown","jump_status":"unknown","target_status":"unknown","proxy_status":"unknown","overall_status":"unknown","reason":"health_not_checked","last_checked":null}'
HEALTH_LAST_PATH_REASON=health_not_checked

while (( attempt <= retries + 1 )); do
  if health_check; then
    health_mark healthy "health check passed; path=${HEALTH_LAST_PATH_REASON}"
    health_recovery_reset
    sync_runtime_state
    log "health OK: liveness=ready network=$([[ -n "${HEALTH_TARGETS:-}" ]] && echo checked || echo skipped) path=${HEALTH_LAST_PATH_REASON}"
    exit 0
  else
    last_rc=$?
  fi
  if (( attempt <= retries )); then
    sleep "$((backoff * attempt))"
  fi
  ((attempt += 1))
done

failure_detail="path=${HEALTH_LAST_PATH_REASON}"
if [[ "$last_rc" -eq 20 || "$last_rc" -eq 30 ]]; then
  failure_detail='network_probe_failed'
fi
health_mark unhealthy "$failure_detail"
sync_runtime_state
warn "health check failed after $((retries + 1)) attempt(s), rc=$last_rc path=${HEALTH_LAST_PATH_REASON}"

if [[ "${HEALTH_AUTO_RECOVER:-true}" == true && "$last_rc" -eq 10 ]]; then
  if ! health_recovery_allowed; then
    warn 'automatic backend recovery suppressed by recovery budget/cooldown'
    exit 1
  fi
  warn 'backend liveness failed; attempting automatic recovery'
  if restart_agent; then
    if health_check; then
      health_mark recovered "automatic backend recovery succeeded; path=${HEALTH_LAST_PATH_REASON}"
      health_recovery_reset
      sync_runtime_state
      log "automatic backend recovery succeeded: path=${HEALTH_LAST_PATH_REASON}"
      exit 0
    fi
  fi
  sync_runtime_state
  warn "automatic backend recovery failed; retry budget retained path=${HEALTH_LAST_PATH_REASON}"
fi

exit 1
