#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH")"
fi
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/profile.sh"
source "$ROOT/lib/backend-capabilities.sh"
source "$ROOT/lib/backend.sh"
source "$ROOT/lib/route.sh"
source "$ROOT/lib/config.sh"
source "$ROOT/lib/health.sh"
source "$ROOT/lib/state.sh"

PROFILE_NAME="${PA_PROFILE:-}"
if [[ "${1:-}" == "--profile" ]]; then
  [[ -n "${2:-}" ]] || die 'usage: proxy-agent-health [--profile <name>]'
  PROFILE_NAME="$2"
  shift 2
fi
[[ $# -eq 0 ]] || die 'usage: proxy-agent-health [--profile <name>]'

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME"
  if [[ "${PA_STATE_DIR_EXPLICIT:-false}" != true ]]; then
    PA_STATE_DIR="${PA_STATE_DIR}/${PROFILE_NAME}"
  fi
  if [[ "${PA_LOG_DIR_EXPLICIT:-false}" != true ]]; then
    PA_LOG_DIR="${PA_LOG_DIR}/${PROFILE_NAME}"
  fi
  apply_config_defaults
else
  load_config
fi

backend_load

liveness_ok() {
  backend_liveness >/dev/null 2>&1
}

network_ok() {
  health_network_status >/dev/null 2>&1
}

health_check() {
  if ! liveness_ok; then
    return 10
  fi
  if [[ "${HEALTH_NETWORK_REQUIRED:-false}" == true ]]; then
    network_ok || return 20
  elif [[ -n "${HEALTH_TARGETS:-}" ]]; then
    network_ok || return 30
  fi
}

restart_agent() {
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" restart
  else
    "$ROOT/bin/proxy-ctl" restart
  fi
}

sync_runtime_state() {
  if [[ -n "$PROFILE_NAME" ]]; then
    "$ROOT/bin/proxy-ctl" --profile "$PROFILE_NAME" status --json=v2 >/dev/null 2>&1 || true
  else
    "$ROOT/bin/proxy-ctl" status --json=v2 >/dev/null 2>&1 || true
  fi
}

retries="${HEALTH_RETRIES:-2}"
backoff="${HEALTH_BACKOFF:-2}"
attempt=1
last_rc=1

while (( attempt <= retries + 1 )); do
  if health_check; then
    health_mark healthy
    health_recovery_reset
    sync_runtime_state
    log "health OK: liveness=ready network=$([[ -n "${HEALTH_TARGETS:-}" ]] && echo checked || echo skipped)"
    exit 0
  else
    last_rc=$?
  fi
  if (( attempt <= retries )); then
    sleep "$((backoff * attempt))"
  fi
  ((attempt += 1))
done

health_mark unhealthy
sync_runtime_state
warn "health check failed after $((retries + 1)) attempt(s), rc=$last_rc"

if [[ "${HEALTH_AUTO_RECOVER:-true}" == true && "$last_rc" -eq 10 ]]; then
  if ! health_recovery_allowed; then
    warn 'automatic backend recovery suppressed by recovery budget/cooldown'
    exit 1
  fi
  warn 'backend liveness failed; attempting automatic recovery'
  if restart_agent; then
    if health_check; then
      health_mark recovered
      health_recovery_reset
      sync_runtime_state
      log 'automatic backend recovery succeeded'
      exit 0
    fi
  fi
  sync_runtime_state
  warn 'automatic backend recovery failed; retry budget retained'
fi

exit 1
